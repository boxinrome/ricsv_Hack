  59              	__STATIC_FORCEINLINE void SystemInitCycleCounter(void);
  60              	#if defined(FACTORY_DATA_SYSTEM_INIT)
  61              	__STATIC_FORCEINLINE void SystemInitTrim(void);
  62              	#endif
  63              	#if defined(WORKAROUND_ERROR_BLDO_NOT_OPERATED)
  64              	__STATIC_FORCEINLINE void       SystemInitWorkaround(void);
  65              	__RAM_TEXT_NOINLINE static void DelayCoreClockDefault(void);
  66              	#endif
  67              	
  68              	/** @} */ /* End of the group MDR32VF0xI_System_Private_Functions_Declarations */
  69              	
  70              	/** @defgroup MDR32VF0xI_System_Exported_Functions MDR32VF0xI System Exported Functions
  71              	 * @{
  72              	 */
  73              	
  74              	/**
  75              	 * @brief  Update SystemCoreClock according to clock register values.
  76              	 * @param  None.
  77              	 * @return None.
  78              	 */
  79              	void SystemCoreClockUpdate(void)
  80              	{
  81              	    uint32_t CPU_C1_Freq = 0, CPU_C2_Freq = 0, CPU_C3_Freq = 0;
  82              	    uint32_t PLL_Mult = 0;
  83              	    uint32_t Temp1 = 0, Temp2 = 0;
  84              	
  85              	    /* Compute CPU_CLK frequency. */
  86              	
  87              	    Temp1 = MDR_RST_CLK->CPU_CLOCK;
  88              	
  89              	    /* Select CPU_CLK from HSI, CPU_C3, LSE, LSI cases. */
  90              	    switch (Temp1 & RST_CLK_CPU_CLOCK_HCLK_SEL_Msk) {
  91              	        case RST_CLK_CPU_CLOCK_HCLK_SEL_HSI:
  92              	            SystemCoreClock = HSI_FREQUENCY_Hz;
  93              	            break;
  94              	
  95              	        case RST_CLK_CPU_CLOCK_HCLK_SEL_LSE:
  96              	            SystemCoreClock = LSE_FREQUENCY_Hz;
  97              	            break;
  98              	
  99              	        case RST_CLK_CPU_CLOCK_HCLK_SEL_LSI:
 100              	            SystemCoreClock = LSI_FREQUENCY_Hz;
 101              	            break;
 102              	
 103              	        case RST_CLK_CPU_CLOCK_HCLK_SEL_CPU_C3:
 104              	            /* Determine CPU_C1 frequency. */
 105              	            switch (Temp1 & RST_CLK_CPU_CLOCK_CPU_C1_SEL_Msk) {
 106              	                case RST_CLK_CPU_CLOCK_CPU_C1_SEL_HSI:
 107              	                    CPU_C1_Freq = HSI_FREQUENCY_Hz;
 108              	                    break;
 109              	                case RST_CLK_CPU_CLOCK_CPU_C1_SEL_HSI_DIV_2:
 110              	                    CPU_C1_Freq = HSI_FREQUENCY_Hz / 2;
 111              	                    break;
 112              	                case RST_CLK_CPU_CLOCK_CPU_C1_SEL_HSE:
 113              	                    CPU_C1_Freq = HSE_FREQUENCY_Hz;
 114              	                    break;
 115              	                case RST_CLK_CPU_CLOCK_CPU_C1_SEL_HSE_DIV_2:
 116              	                    CPU_C1_Freq = HSE_FREQUENCY_Hz / 2;
 117              	                    break;
 118              	            }
 119              	
 120              	            /* Determine CPU_C2 frequency. */
 121              	            if ((Temp1 & RST_CLK_CPU_CLOCK_CPU_C2_SEL) != 0) {
 122              	                /* Determine CPU PLL output frequency. */
 123              	                Temp2    = MDR_RST_CLK->PLL_CONTROL;
 124              	                PLL_Mult = ((Temp2 & RST_CLK_PLL_CONTROL_PLL_CPU_MUL_Msk) >> RST_CLK_PLL_CONTROL_PL
 125              	
 126              	                /* Determine CPU_PLL source. */
 127              	                if ((Temp2 & RST_CLK_PLL_CONTROL_PLL_CPU_SEL) != 0) {
 128              	                    CPU_C2_Freq = CPU_C1_Freq * PLL_Mult;
 129              	                } else {
 130              	                    CPU_C2_Freq = HSE_FREQUENCY_Hz * PLL_Mult;
 131              	                }
 132              	            } else {
 133              	                CPU_C2_Freq = CPU_C1_Freq;
 134              	            }
 135              	
 136              	            /* Determine CPU_C3 frequency. */
 137              	            Temp1 = ((Temp1 & RST_CLK_CPU_CLOCK_CPU_C3_SEL_Msk) >> RST_CLK_CPU_CLOCK_CPU_C3_SEL_Pos
 138              	            if ((Temp1 & 0x8U) == 0x00) {
 139              	                CPU_C3_Freq = CPU_C2_Freq;
 140              	            } else {
 141              	                CPU_C3_Freq = CPU_C2_Freq >> ((Temp1 & 0x7U) + 1);
 142              	            }
 143              	            SystemCoreClock = CPU_C3_Freq;
 144              	            break;
 145              	    }
 146              	}
 147              	
 148              	/**
 149              	 * @brief  Setup the microcontroller system:
 150              	 *          - SystemCoreClock variable;
 151              	 *          - cycle counter configuration;
 152              	 *          - interrupt configuration.
 153              	 * @note   This function should be used only after reset.
 154              	 * @param  None.
 155              	 * @return None.
 156              	 */
 157              	void SystemInit(void)
 158              	{
 159              	
 160              	#if defined(FACTORY_DATA_SYSTEM_INIT)
 161              	    SystemInitTrim();
 162              	#endif
 163              	#if defined(WORKAROUND_ERROR_BLDO_NOT_OPERATED)
 164              	    SystemInitWorkaround();
 165              	#endif
 166              	    SystemInitIRQ();
 167              	    SystemInitCycleCounter();
 168              	
 169              	    SystemCoreClockUpdate();
 170              	}
 171              	
 172              	/** @} */ /* End of group MDR32VF0xI_System_Exported_Functions */
 173              	
 174              	/** @defgroup MDR32VF0xI_System_Private_Functions MDR32VF0xI System Private Functions
 175              	 * @{
 176              	 */
 177              	
 178              	/**
 179              	 * @brief  Setup the microcontroller interrupt controller.
 180              	 * @param  None.
 181              	 * @return None.
 182              	 */
 183              	__STATIC_FORCEINLINE void SystemInitIRQ(void)
 184              	{
 185              	#if defined(USE_MDR32F02)
 186              	    int Index;
 187              	
 188              	    /* Disable all interrupts in MCU. */
 189              	    IT_GlobalDisableIRQ();
 190              	    PLIC_DisableExternalIRQ(PLIC_PRIVILEGE_IRQ_MODE_M);
 191              	    /* Set lowest PLIC IRQ threshold. */
 192              	    PLIC_SetThresholdIRQ(PLIC_THRESHOLD_0_ENABLE_ALL);
 193              	    /* Set the minimum priority for each interrupt vector. */
 194              	    for (Index = 1; Index < 31; Index++) {
 195              	        if (Index == 19) {
 196              	            Index++;
 197              	        }
 198              	        PLIC_SetPriorityIRQ((IRQn_TypeDef)Index, PLIC_PRIORITY_LOWEST);
 199              	    }
 200              	#if defined(PLIC_SYSTEM_INIT)
 201              	    /* Algorithm for removing an interrupt request to the PLIC block from DMA. */
 202              	
 203              	    /* Enable SSP block clocking to complete generation of DMA requests. */
 204              	    MDR_RST_CLK->PER2_CLOCK |= (RST_CLK_PER2_CLOCK_PCLK_EN_SSP1 |
 205              	                                RST_CLK_PER2_CLOCK_PCLK_EN_SSP2 |
 206              	                                RST_CLK_PER2_CLOCK_PCLK_EN_SSP3);
 207              	    /* Enable DMA interrupt in PLIC block. */
 208              	    PLIC_EnableIRQ(DMA_IRQn);
 209              	    /* Terminate with DMA interrupt in PLIC block. */
 210              	    IRQn_TypeDef irqn = PLIC_ClaimIRQ();
 211              	    PLIC_CompleteIRQ(irqn);
 212              	    /* Disable DMA interrupt in PLIC block. */
 213              	    PLIC_DisableIRQ(DMA_IRQn);
 214              	    /* Set Trap_IRQHandler in PLIC. */
 215              	    PLIC_SetTrapVector(PLIC_PRIVILEGE_IRQ_MODE_M, (IRQHandler_TypeDef)Trap_IRQHandler);
 216              	    /* Disable SSP block clocking. */
 217              	    MDR_RST_CLK->PER2_CLOCK &= ~(RST_CLK_PER2_CLOCK_PCLK_EN_SSP1 |
 218              	                                 RST_CLK_PER2_CLOCK_PCLK_EN_SSP2 |
 219              	                                 RST_CLK_PER2_CLOCK_PCLK_EN_SSP3);
 220              	#endif
 221              	    /* Enable all interrupts in MCU. */
 222              	    IT_GlobalEnableIRQ();
 223              	    PLIC_EnableExternalIRQ(PLIC_PRIVILEGE_IRQ_MODE_M);
 224              	
 225              	#elif defined(USE_MDR1206FI) || defined(USE_MDR1206AFI) || defined(USE_MDR1206)
 226              	#if defined(CLIC_SYSTEM_INIT)
 227              	    CLIC_InitTypeDef     CLIC_InitStruct;
 228              	    CLIC_IRQ_InitTypeDef CLIC_InitStructIRQ;
 229              	#endif
 230              	
 231              	    IT_GlobalDisableIRQ(IT_PRIVILEGE_MODE_IRQ_M);
 232              	#if defined(CLIC_SYSTEM_INIT)
 233              	    /* Initializing CLIC global parameters. */
 234              	    CLIC_InitStruct.CLIC_PrivilegeLevels = CLIC_SYSTEM_INIT_PRIVILEGE_LEVELS;
 235              	    CLIC_InitStruct.CLIC_MaxLevels       = CLIC_SYSTEM_INIT_MAX_LEVELS;
 236              	    CLIC_Init(&CLIC_InitStruct);
 237              	    /* Initializing CLIC IRQ parameters. */
 238              	    CLIC_InitStructIRQ.CLIC_EnableIRQ        = DISABLE;
 239              	    CLIC_InitStructIRQ.CLIC_TriggerIRQ       = CLIC_SYSTEM_INIT_TRIGGER_IRQ;
 240              	    CLIC_InitStructIRQ.CLIC_PrivilegeModeIRQ = CLIC_SYSTEM_INIT_PRIVILEGE_MODE_IRQ;
 241              	#if defined(CLIC_SYSTEM_INIT_VECTOR_MODE_IRQ)
 242              	    CLIC_InitStructIRQ.CLIC_VectorModeIRQ = ENABLE;
 243              	#else
 244              	    CLIC_InitStructIRQ.CLIC_VectorModeIRQ = DISABLE;
 245              	#endif
 246              	    CLIC_InitStructIRQ.CLIC_LevelIRQ    = 1;
 247              	    CLIC_InitStructIRQ.CLIC_PriorityIRQ = 1;
 248              	    CLIC_InitAllIRQ(&CLIC_InitStructIRQ);
 249              	    /* Set rising edge triggering for DMA interrupt. */
 250              	    CLIC_InitStructIRQ.CLIC_TriggerIRQ = CLIC_TRIGGER_IRQ_EDGE_RISING;
 251              	    CLIC_InitIRQ(DMA_IRQn, &CLIC_InitStructIRQ);
 252              	#endif
 253              	    CLIC_SetTrapVector(CLIC_PRIVILEGE_MODE_IRQ_M, (IRQHandler_TypeDef)Trap_IRQHandler);
 254              	    CLIC_SetVectorTable(CLIC_PRIVILEGE_MODE_IRQ_M, InterruptVectorTable);
 255              	    IT_GlobalEnableIRQ(IT_PRIVILEGE_MODE_IRQ_M);
 256              	#endif
 257              	}
 258              	
