  38              	/** @defgroup MDR32VF0xI_System_Exported_Variables MDR32VF0xI System Exported Variables
  39              	 * @{
  40              	 */
  41              	
  42              	/**
  43              	 * @brief System clock frequency (core clock) value.
  44              	 */
  45              	
  46              	#if defined(USE_MDR32F02)
  47              	uint32_t SystemCoreClock = HSI_FREQUENCY_Hz;
  48              	#elif defined(USE_MDR1206FI) || defined(USE_MDR1206AFI) || defined(USE_MDR1206)
  49              	uint32_t SystemCoreClock = HSI_FREQUENCY_Hz / 16;
  50              	#endif
  51              	
  52              	/** @} */ /* End of group MDR32VF0xI_System_Exported_Variables */
  53              	
  54              	/** @defgroup MDR32VF0xI_System_Private_Functions_Declarations MDR32VF0xI System Private Functions 
  55              	 * @{
  56              	 */
  57              	
