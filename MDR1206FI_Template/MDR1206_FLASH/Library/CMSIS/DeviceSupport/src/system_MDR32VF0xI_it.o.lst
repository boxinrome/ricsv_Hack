 633              	
 634              	/** @addtogroup MDR32VF0xI_System_IT_Exported_Trap_Handlers MDR32VF0xI System IT Exported Trap Hand
 635              	 * @{
 636              	 */
 637              	
 638              	#if defined(USE_MDR32F02)
 639              	/**
 640              	 * @brief  PLIC service routine for interrupts and exceptions.
 641              	 * @param  None.
 642              	 * @return None.
 643              	 */
 644              	__WEAK __RAM_TEXT __INTERRUPT_MACHINE __TRAP_HANDLER_ALIGNED void Trap_IRQHandler(void)
 645              	{
 646              	    IRQn_TypeDef ExtInterrupt;
 647              	    uint32_t     MCause;
 648              	
 649              	    MCause = CSR_Read(CSR_MCAUSE);
 650              	    if ((MCause & CSR_MCAUSE_INTERRUPT) != 0) {
 651              	        if (MCause == (CSR_MCAUSE_EXCCODE_MEI | CSR_MCAUSE_INTERRUPT)) {
 652              	            ExtInterrupt = PLIC_ClaimIRQ();
 653              	            while (ExtInterrupt) {
 654              	                if (ExtInterrupt == DMA_IRQn) {
 655              	                    PLIC_CompleteIRQ(ExtInterrupt);
 656              	                }
 657              	                ExtInterruptVectorTable[(uint32_t)ExtInterrupt]();
 658              	                if (ExtInterrupt != DMA_IRQn) {
 659              	                    PLIC_CompleteIRQ(ExtInterrupt);
 660              	                }
 661              	                ExtInterrupt = PLIC_ClaimIRQ();
 662              	            }
 663              	        } else {
 664              	            InterruptVectorTable[MCause & CSR_MCAUSE_EXCCODE_Msk]();
 665              	        }
 666              	    } else {
 667              	        ExceptionVectorTable[MCause]();
 668              	    }
 669              	}
 670              	
 671              	#elif defined(USE_MDR1206FI) || defined(USE_MDR1206AFI) || defined(USE_MDR1206)
 672              	#if defined(CLIC_TRAP_MACHINE_PREEMPTIBLE)
 673              	/**
 674              	 * @brief   CLIC service routine for non-vectored interrupts and exceptions.
 675              	 *          Non-vectored interrupts are executed with preemption, exceptions are executed without p
 676              	 * @warning Only safe for horizontal interrupts.
 677              	 * @param   None.
 678              	 * @return  None.
 679              	 */
 680              	__WEAK __RAM_TEXT __INTERRUPT_MACHINE __TRAP_HANDLER_ALIGNED void Trap_IRQHandler(void)
 681              	{
 682              	    uint32_t            MCause, MEpc;
 683              	    IRQHandler_TypeDef* IT_IRQHandler;
 684              	
 685              	    MCause = CSR_Read(CSR_MCAUSE);
 686              	    if ((MCause & CSR_MCAUSE_INTERRUPT) != 0) {
 687              	        MEpc          = CSR_Read(CSR_MCAUSE);
 688              	        IT_IRQHandler = (IRQHandler_TypeDef*)CSR_ReadSetBits(CSR_MNXTI, CSR_MSTATUS_MIE);
 689              	        while (IT_IRQHandler) {
 690              	            (*IT_IRQHandler)();
