 752              	/**
 753              	 * @brief  Get the global enable interrupt status for machine privilege mode.
 754              	 * @param  None.
 755              	 * @return Global enable interrupt status for machine privilege mode.
 756              	 */
 757              	FlagStatus IT_GetGlobalEnableIRQ(void)
 758              	{
 759              	    FlagStatus Status;
 760              	    uint32_t   MStatus;
 761              	
 762              	    MStatus = CSR_Read(CSR_MSTATUS);
 763              	
 764              	    if (MStatus & CSR_MSTATUS_MIE) {
 765              	        Status = SET;
 766              	    } else {
 767              	        Status = RESET;
 768              	    }
 769              	
 770              	    return Status;
 771              	}
