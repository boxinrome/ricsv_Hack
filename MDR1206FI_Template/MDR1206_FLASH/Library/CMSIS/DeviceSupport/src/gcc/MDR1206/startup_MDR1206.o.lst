  53              	#define _MDR32VF0xI_SPL_VERSION_PATCH ((uint32_t)0) /*!< [7:0]   - patch version. */
  54              	
  55              	/** MDR32VF0xI SPL version number (combined value). */
  56              	#define MDR32VF0xI_SPL_VERSION ((_MDR32VF0xI_SPL_VERSION_MAJOR << 16) | \
  57              	                                (_MDR32VF0xI_SPL_VERSION_MINOR << 8) |  \
  58              	                                (_MDR32VF0xI_SPL_VERSION_PATCH))
