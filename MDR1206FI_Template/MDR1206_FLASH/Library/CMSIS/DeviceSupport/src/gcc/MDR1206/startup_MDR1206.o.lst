  85              	    /* Global pointer (gp) allows using more effective gp-relative addressing instead of
  86              	       abosulte/pc-relative for arbitrary 4KiB memory range. For the optimisation to be effective,
  87              	       it should cover the most intensely used RAM area. For standard newlib apps, this is the
  88              	       area where the .sdata section is located. The linker uses the (!) __global_pointer$ symbol
  89              	       definition to compare the memory addresses and, if within range, it replaces
  90              	       absolute/pc-relative addressing with gp-relative addressing, which makes the code more
  91              	       efficient. This process is also called relaxing, and can be disabled by -Wl,--no-relax.
  92              	       The gp register should be loaded during startup and should not be changed later. */
  93              	    .option push
  94              	    .option norelax
