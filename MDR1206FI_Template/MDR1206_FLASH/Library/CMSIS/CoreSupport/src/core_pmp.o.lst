  50              	
  51              	#define IS_PMP_GRANULARITY_ALIGNED(VALUE)       (((VALUE) & ((1UL << PMP_GRANULARITY) - 1)) == 0)
  52              	#define IS_PMP_SIZE_ALIGNED(VALUE, SIZE)        (((VALUE) & ((SIZE) - 1)) == 0)
  53              	#define IS_PMP_POWER_OF_2(VALUE)                ((VALUE) && (((VALUE) & ((VALUE) - 1)) == 0))
  54              	
  55              	#define IS_PMP_R_W_ACCESS_RESERVED(READ, WRITE) ((READ) | !(WRITE))
  56              	
  57              	#if (__riscv_xlen == 64)
  58              	#define IS_PMP_MAX_SIZE(VALUE) ((VALUE) < (1UL << 55))
  59              	#endif
