 325              	
 326              	/** @addtogroup CORE_CLIC_IRQ_Control_Functions CLIC IRQ Control Functions
 327              	 * @{
 328              	 */
 329              	
 330              	/**
 331              	 * @brief  Initialize the CLIC interrupt according to the specified
 332              	 *         parameters in the CLIC_InitStructIRQ.
 333              	 * @note   The interrupt pending bit is undefined when switching from level-sensitive mode to edge-
 334              	 * @note   If the CLIC_LevelIRQ or CLIC_PriorityIRQ values in CLIC_InitStructIRQ being set are grea
 335              	 *         than the maximum allowed values, then the maximum allowed values will be written to the 
 336              	 * @param  IRQn: Device specific interrupt number.
 337              	 * @param  CLIC_InitStructIRQ: The pointer to the @ref CLIC_IRQ_InitTypeDef structure
 338              	 *         that contains the configuration information for the CLIC interrupt.
 339              	 * @return None.
 340              	 */
 341              	void CLIC_InitIRQ(IRQn_TypeDef IRQn, const CLIC_IRQ_InitTypeDef* CLIC_InitStructIRQ)
 342              	{
 343              	    uint32_t TmpReg;
 344              	
 345              	    /* Check the parameters. */
 346              	    assert_param(IS_IRQ(IRQn));
 347              	
 348              	    TmpReg                                        = CLIC_GetConfigIRQ(CLIC_InitStructIRQ);
 349              	    *((__IO uint32_t*)&CLIC->INT[(uint32_t)IRQn]) = TmpReg;
 350              	}
 351              	
 352              	/**
 353              	 * @brief  Initialize all CLIC interrupts according to the specified
 354              	 *         parameters in the CLIC_InitStructIRQ.
 355              	 * @note   The interrupt pending bit is undefined when switching from level-sensitive mode to edge-
 356              	 * @note   If the CLIC_LevelIRQ or CLIC_PriorityIRQ values in CLIC_InitStructIRQ being set are grea
 357              	 *         than the maximum allowed values, then the maximum allowed values will be written to the 
 358              	 * @param  CLIC_InitStructIRQ: The pointer to the @ref CLIC_IRQ_InitTypeDef structure
 359              	 *         that contains the configuration information for the CLIC interrupt.
 360              	 * @return None.
 361              	 */
 362              	void CLIC_InitAllIRQ(const CLIC_IRQ_InitTypeDef* CLIC_InitStructIRQ)
 363              	{
 364              	    __IO uint32_t* PtrReg;
 365              	    uint32_t       TmpReg, IRQNum;
 366              	
 367              	    TmpReg = CLIC_GetConfigIRQ(CLIC_InitStructIRQ);
 368              	    PtrReg = (__IO uint32_t*)&CLIC->INT[0];
 369              	
 370              	    for (IRQNum = 0; IRQNum < CLIC_NUM_INTERRUPTS; IRQNum++) {
 371              	        PtrReg[IRQNum] = TmpReg;
 372              	    }
 373              	}
 374              	
 375              	/**
 376              	 * @brief  Fill each CLIC_InitStructIRQ member with its default value.
 377              	 * @param  CLIC_InitStructIRQ: The pointer to the @ref CLIC_IRQ_InitTypeDef structure
 378              	 *         which is to be initialized.
 379              	 * @return None.
 380              	 */
 381              	void CLIC_StructInitIRQ(CLIC_IRQ_InitTypeDef* CLIC_InitStructIRQ)
 382              	{
 383              	    CLIC_InitStructIRQ->CLIC_EnableIRQ        = DISABLE;
 384              	    CLIC_InitStructIRQ->CLIC_VectorModeIRQ    = ENABLE;
 385              	    CLIC_InitStructIRQ->CLIC_TriggerIRQ       = CLIC_TRIGGER_IRQ_LEVEL_HIGH;
 386              	    CLIC_InitStructIRQ->CLIC_PrivilegeModeIRQ = CLIC_PRIVILEGE_MODE_IRQ_M;
 387              	    CLIC_InitStructIRQ->CLIC_LevelIRQ         = 1;
 388              	    CLIC_InitStructIRQ->CLIC_PriorityIRQ      = 1;
 389              	}
 390              	
 391              	/**
 392              	 * @brief  Enable interrupt.
 393              	 * @param  IRQn: Device specific interrupt number.
 394              	 * @return None.
 395              	 */
 396              	void CLIC_EnableIRQ(IRQn_TypeDef IRQn)
 397              	{
 398              	    /* Check the parameters. */
 399              	    assert_param(IS_IRQ(IRQn));
 400              	
 401              	    CLIC->INT[(uint32_t)IRQn].IE = 1;
 402              	}
 403              	
 404              	/**
 405              	 * @brief  Disable interrupt.
 406              	 * @param  IRQn: Device specific interrupt number.
 407              	 * @return None.
 408              	 */
 409              	void CLIC_DisableIRQ(IRQn_TypeDef IRQn)
 410              	{
 411              	    /* Check the parameters. */
 412              	    assert_param(IS_IRQ(IRQn));
 413              	
 414              	    CLIC->INT[(uint32_t)IRQn].IE = 0;
 415              	}
 416              	
 417              	/**
 418              	 * @brief  Get the interrupt enable status.
 419              	 * @param  IRQn: Device specific interrupt number.
 420              	 * @return @ref ITStatus - interrupt enable status (SET or RESET).
 421              	 */
 422              	ITStatus CLIC_GetEnableIRQ(IRQn_TypeDef IRQn)
 423              	{
 424              	    ITStatus Status;
 425              	
 426              	    /* Check the parameters. */
 427              	    assert_param(IS_IRQ(IRQn));
 428              	
 429              	    if (CLIC->INT[(uint32_t)IRQn].IE == 0) {
 430              	        Status = RESET;
 431              	    } else {
 432              	        Status = SET;
 433              	    }
 434              	
 435              	    return Status;
 436              	}
