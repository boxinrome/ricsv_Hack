 513              	/**
 514              	 * @brief  Get the vector mode status for interrupt.
 515              	 * @param  IRQn: Device specific interrupt number.
 516              	 * @return @ref FlagStatus - vector mode status for interrupt (SET or RESET).
 517              	 */
 518              	FlagStatus CLIC_GetVectorModeIRQ(IRQn_TypeDef IRQn)
 519              	{
