 599              	/**
 600              	 * @brief  Set interrupt level.
 601              	 * @note   If Level being set is greater than the maximum allowed level,
 602              	 *         it will be forced to the maximum allowed level.
 603              	 * @param  IRQn: Device specific interrupt number.
 604              	 * @param  Level: Interrupt level to set.
 605              	 * @return None.
 606              	 */
 607              	void CLIC_SetLevelIRQ(IRQn_TypeDef IRQn, uint8_t Level)
 608              	{
 609              	    uint8_t TmpReg, LevelBits, LevelMask, LevelMax;
 610              	
 611              	    /* Check the parameters. */
 612              	    assert_param(IS_IRQ(IRQn));
 613              	
 614              	    LevelBits = (CLIC->CFG & CLIC_CFG_NLBITS_Msk) >> CLIC_CFG_NLBITS_Pos;
 615              	    if (LevelBits != 0) {
 616              	        LevelMask = 0xFFUL << (8U - LevelBits);
 617              	
 618              	        LevelMax = (uint8_t)((1U << LevelBits) - 1);
 619              	        if (Level > LevelMax) {
 620              	            Level = LevelMax;
 621              	        }
 622              	
 623              	        TmpReg = CLIC->INT[(uint32_t)IRQn].CTL & ~LevelMask;
 624              	        TmpReg |= Level << (8U - LevelBits);
 625              	        CLIC->INT[(uint32_t)IRQn].CTL = TmpReg;
 626              	    }
 627              	}
 628              	
 629              	/**
 630              	 * @brief  Get interrupt level.
 631              	 * @param  IRQn: Device specific interrupt number.
 632              	 * @return Interrupt level.
 633              	 */
 634              	uint8_t CLIC_GetLevelIRQ(IRQn_TypeDef IRQn)
 635              	{
 636              	    uint8_t Level, LevelBits;
 637              	
 638              	    /* Check the parameters. */
 639              	    assert_param(IS_IRQ(IRQn));
 640              	
 641              	    LevelBits = (CLIC->CFG & CLIC_CFG_NLBITS_Msk) >> CLIC_CFG_NLBITS_Pos;
 642              	    Level     = CLIC->INT[(uint32_t)IRQn].CTL >> (8U - LevelBits);
 643              	
 644              	    return Level;
 645              	}
 646              	
 647              	/**
 648              	 * @brief  Set interrupt priority.
 649              	 * @note   If Priority being set is greater than the maximum allowed priority,
 650              	 *         it will be forced to the maximum allowed priority.
 651              	 * @param  IRQn: Device specific interrupt number.
 652              	 * @param  Priority: Interrupt priority to set.
 653              	 * @return None.
 654              	 */
 655              	void CLIC_SetPriorityIRQ(IRQn_TypeDef IRQn, uint8_t Priority)
 656              	{
 657              	    uint8_t TmpReg, LevelBits, PriorityBits, PriorityMask, PriorityMax;
 658              	
 659              	    /* Check the parameters. */
 660              	    assert_param(IS_IRQ(IRQn));
 661              	
 662              	    LevelBits = (CLIC->CFG & CLIC_CFG_NLBITS_Msk) >> CLIC_CFG_NLBITS_Pos;
 663              	    if (LevelBits < CLIC_INTxCTL_BITS) {
 664              	        PriorityBits = ((uint8_t)CLIC_INTxCTL_BITS - LevelBits);
 665              	        PriorityMask = (uint8_t)(0xFFUL >> (8U - PriorityBits)) << CLIC_INTxCTL_BITS;
 666              	
 667              	        PriorityMax = (uint8_t)((1U << PriorityBits) - 1);
 668              	        if (Priority > PriorityMax) {
 669              	            Priority = PriorityMax;
 670              	        }
 671              	
 672              	        TmpReg = CLIC->INT[(uint32_t)IRQn].CTL & ~PriorityMask;
 673              	        TmpReg |= Priority << CLIC_INTxCTL_BITS;
 674              	        CLIC->INT[(uint32_t)IRQn].CTL = TmpReg;
 675              	    }
 676              	}
 677              	
 678              	/**
 679              	 * @brief  Get interrupt priority.
 680              	 * @param  IRQn: Device specific interrupt number.
 681              	 * @return Interrupt priority.
 682              	 */
 683              	uint8_t CLIC_GetPriorityIRQ(IRQn_TypeDef IRQn)
 684              	{
 685              	    uint8_t LevelBits, PriorityBits, Priority, PriorityMask;
 686              	
 687              	    /* Check the parameters. */
 688              	    assert_param(IS_IRQ(IRQn));
 689              	
 690              	    LevelBits = (CLIC->CFG & CLIC_CFG_NLBITS_Msk) >> CLIC_CFG_NLBITS_Pos;
 691              	    if (LevelBits < CLIC_INTxCTL_BITS) {
 692              	        PriorityBits = CLIC_INTxCTL_BITS - LevelBits;
 693              	        PriorityMask = 0xFFUL >> (8U - PriorityBits);
 694              	        Priority     = (CLIC->INT[(uint32_t)IRQn].CTL >> CLIC_INTxCTL_BITS) & PriorityMask;
 695              	    } else {
 696              	        Priority = 0;
 697              	    }
 698              	
 699              	    return Priority;
 700              	}
