 101              	/** @addtogroup CORE_CLIC_Control_Functions CLIC Control Functions
 102              	 * @{
 103              	 */
 104              	
 105              	/**
 106              	 * @brief  Initialize the CLIC according to the specified
 107              	 *         parameters in the CLIC_InitStruct.
 108              	 * @param  CLIC_InitStruct: The pointer to the @ref CLIC_InitTypeDef structure
 109              	 *         that contains the configuration information for the CLIC.
 110              	 * @return None.
 111              	 */
 112              	void CLIC_Init(const CLIC_InitTypeDef* CLIC_InitStruct)
 113              	{
 114              	    uint8_t TmpReg;
 115              	
 116              	    /* Check the parameters. */
 117              	    assert_param(IS_CLIC_PRIVILEGE_LEVELS(CLIC_InitStruct->CLIC_PrivilegeLevels));
 118              	    assert_param(IS_CLIC_MAX_LEVELS(CLIC_InitStruct->CLIC_MaxLevels));
 119              	
 120              	    TmpReg = (uint8_t)CLIC_InitStruct->CLIC_PrivilegeLevels |
 121              	             (uint8_t)CLIC_InitStruct->CLIC_MaxLevels;
 122              	
 123              	    CLIC->CFG = TmpReg;
 124              	}
 125              	
 126              	/**
 127              	 * @brief  Fill each CLIC_InitStruct member with its default value.
 128              	 * @param  CLIC_InitStruct: The pointer to the @ref CLIC_InitTypeDef structure
 129              	 *         which is to be initialized.
 130              	 * @return None.
 131              	 */
 132              	void CLIC_StructInit(CLIC_InitTypeDef* CLIC_InitStruct)
 133              	{
 134              	    CLIC_InitStruct->CLIC_PrivilegeLevels = CLIC_PRIVILEGE_LEVELS_M;
 135              	#if (CLIC_INTxCTL_BITS == 0)
 136              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_1;
 137              	#elif (CLIC_INTxCTL_BITS == 1)
 138              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_2;
 139              	#elif (CLIC_INTxCTL_BITS == 2)
 140              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_2;
 141              	#elif (CLIC_INTxCTL_BITS == 3)
 142              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_4;
 143              	#elif (CLIC_INTxCTL_BITS == 4)
 144              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_4;
 145              	#elif (CLIC_INTxCTL_BITS == 5)
 146              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_8;
 147              	#elif (CLIC_INTxCTL_BITS == 6)
 148              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_8;
 149              	#elif (CLIC_INTxCTL_BITS == 7)
 150              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_16;
 151              	#elif (CLIC_INTxCTL_BITS == 8)
 152              	    CLIC_InitStruct->CLIC_MaxLevels = CLIC_MAX_LEVELS_16;
 153              	#endif
 154              	}
 155              	
 156              	/**
 157              	 * @brief  Get CLIC configuration.
 158              	 * @param  CLIC_ConfigStruct: The pointer to the @ref CLIC_Config_TypeDef structure
 159              	 *         into which the configuration data will be written.
 160              	 * @return None.
 161              	 */
 162              	void CLIC_GetConfig(CLIC_Config_TypeDef* CLIC_ConfigStruct)
 163              	{
 164              	    uint32_t TmpINFO;
 165              	    uint8_t  TmpCFG, LevelBits, PriorityBits;
 166              	
 167              	    TmpINFO                                       = CLIC->INFO;
 168              	    CLIC_ConfigStruct->CLIC_LevelPriotityBits     = (TmpINFO & CLIC_INFO_CLICINTCTLBITS_Msk) >> CLI
 169              	    CLIC_ConfigStruct->CLIC_Interrupts            = (TmpINFO & CLIC_INFO_NUM_INTERRUPT_Msk) >> CLIC
 170              	    CLIC_ConfigStruct->CLIC_Triggers              = (TmpINFO & CLIC_INFO_NUM_TRIGGER_Msk) >> CLIC_I
 171              	    CLIC_ConfigStruct->CLIC_ImplementationVersion = (TmpINFO & CLIC_INFO_IMPL_VERSION_Msk) >> CLIC_
 172              	    CLIC_ConfigStruct->CLIC_ArchitectureVersion   = (TmpINFO & CLIC_INFO_ARCH_VERSION_Msk) >> CLIC_
 173              	
 174              	    TmpCFG    = CLIC->CFG;
 175              	    LevelBits = (TmpCFG & CLIC_CFG_NLBITS_Msk) >> CLIC_CFG_NLBITS_Pos;
 176              	    if (LevelBits < CLIC_INTxCTL_BITS) {
 177              	        PriorityBits = CLIC_INTxCTL_BITS - LevelBits;
 178              	    } else {
 179              	        LevelBits    = CLIC_INTxCTL_BITS;
 180              	        PriorityBits = 0;
 181              	    }
 182              	    CLIC_ConfigStruct->CLIC_PrivilegeLevels  = (CLIC_PrivilegeLevels_TypeDef)(TmpCFG & CLIC_CFG_NMB
 183              	    CLIC_ConfigStruct->CLIC_VectoringSupport = (FlagStatus)((TmpCFG & CLIC_CFG_NVBITS) >> CLIC_CFG_
 184              	    CLIC_ConfigStruct->CLIC_MaxLevels        = (uint8_t)(1UL << LevelBits);
 185              	    CLIC_ConfigStruct->CLIC_MaxPriorities    = (uint8_t)(1UL << PriorityBits);
 186              	}
 187              	
 188              	/**
 189              	 * @brief  Set interrupt vector table.
 190              	 * @param  PrivilegeMode: @ref CLIC_PrivilegeModeIRQ_TypeDef - interrupt privilege mode.
 191              	 * @param  VectorTable: @ref IRQHandler_TypeDef - pointer to the interrupt vector table.
 192              	 * @return None.
 193              	 */
 194              	void CLIC_SetVectorTable(CLIC_PrivilegeModeIRQ_TypeDef PrivilegeMode, IRQHandler_TypeDef* VectorTab
 195              	{
 196              	    /* Check the parameters. */
 197              	    assert_param(IS_CLIC_PRIVILEGE_MODE_IRQ(PrivilegeMode));
 198              	    assert_param(IS_CLIC_xTVT_ALIGNED(VectorTable));
 199              	
 200              	    switch (PrivilegeMode) {
 201              	#if (CLIC_PRIVILEGE_MODES >= 1)
 202              	        case CLIC_PRIVILEGE_MODE_IRQ_M:
 203 000e 73907530 	            CSR_Write(CSR_MTVT, (uint_xlen_t)VectorTable & CSR_xTVT_TBASE_Msk);
 204              	            break;
 331              		csrw 775, a1
 332              	# 0 "" 2
