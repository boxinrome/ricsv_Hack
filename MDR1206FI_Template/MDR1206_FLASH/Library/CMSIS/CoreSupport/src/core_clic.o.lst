 523              	    assert_param(IS_IRQ(IRQn));
 524              	
 525              	    if ((CLIC->INT[(uint32_t)IRQn].ATTR & CLIC_INTxATTR_SHV_Msk) == 0) {
 526              	        Status = RESET;
 527              	    } else {
 528              	        Status = SET;
 529              	    }
 530              	
 531              	    return Status;
 532              	}
