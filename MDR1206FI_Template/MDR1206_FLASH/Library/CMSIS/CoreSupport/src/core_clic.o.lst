  44              	/** @addtogroup CORE_CLIC_Private_Functions CLIC Private Functions
  45              	 * @{
  46              	 */
  47              	
  48              	/**
  49              	 * @brief  Get the 32-bit value of the CLIC interrupt register according
  50              	 *         to the specified parameters in the CLIC_InitStructIRQ.
  51              	 * @note   If the CLIC_LevelIRQ or CLIC_PriorityIRQ values in CLIC_InitStructIRQ being set are grea
  52              	 *         than the maximum allowed values, they will be forced to the maximum allowed values.
  53              	 * @param  CLIC_InitStructIRQ: The pointer to the @ref CLIC_IRQ_InitTypeDef structure
  54              	 *         that contains the configuration information for the CLIC interrupt.
  55              	 * @return The value of the CLIC interrupt register.
  56              	 */
  57              	uint32_t CLIC_GetConfigIRQ(const CLIC_IRQ_InitTypeDef* CLIC_InitStructIRQ)
  58              	{
  59              	    uint32_t TmpINT, TmpINT_CTL = 0, TmpINT_ATTR, TmpINT_IE;
  60              	    uint8_t  LevelBits, LevelMax, PriorityBits, PriorityMax;
  61              	
  62              	    /* Check the parameters. */
  63              	    assert_param(IS_FUNCTIONAL_STATE(CLIC_InitStructIRQ->CLIC_EnableIRQ));
  64              	    assert_param(IS_FUNCTIONAL_STATE(CLIC_InitStructIRQ->CLIC_VectorModeIRQ));
  65              	    assert_param(IS_CLIC_TRIGGER_IRQ(CLIC_InitStructIRQ->CLIC_TriggerIRQ));
  66              	    assert_param(IS_CLIC_PRIVILEGE_MODE_IRQ(CLIC_InitStructIRQ->CLIC_PrivilegeModeIRQ));
  67              	
  68              	    LevelBits = (CLIC->CFG & CLIC_CFG_NLBITS_Msk) >> CLIC_CFG_NLBITS_Pos;
  69              	    if (LevelBits != 0) {
  70              	        LevelMax = (uint8_t)((1U << LevelBits) - 1);
  71              	        if (CLIC_InitStructIRQ->CLIC_LevelIRQ > LevelMax) {
  72              	            TmpINT_CTL = (uint32_t)LevelMax << (8U - LevelBits);
  73              	        } else {
  74              	            TmpINT_CTL = (uint32_t)CLIC_InitStructIRQ->CLIC_LevelIRQ << (8U - LevelBits);
  75              	        }
  76              	    }
  77              	    if (LevelBits < CLIC_INTxCTL_BITS) {
  78              	        PriorityBits = ((uint8_t)CLIC_INTxCTL_BITS - LevelBits);
  79              	        PriorityMax  = (uint8_t)((1U << PriorityBits) - 1);
  80              	        if (CLIC_InitStructIRQ->CLIC_PriorityIRQ > PriorityMax) {
  81              	            TmpINT_CTL |= (uint32_t)PriorityMax << CLIC_INTxCTL_BITS;
  82              	        } else {
  83              	            TmpINT_CTL |= (uint32_t)CLIC_InitStructIRQ->CLIC_PriorityIRQ << CLIC_INTxCTL_BITS;
  84              	        }
  85              	    }
  86              	    TmpINT_ATTR = (uint32_t)CLIC_InitStructIRQ->CLIC_VectorModeIRQ |
  87              	                  (uint32_t)CLIC_InitStructIRQ->CLIC_TriggerIRQ |
  88              	                  (uint32_t)CLIC_InitStructIRQ->CLIC_PrivilegeModeIRQ;
  89              	    TmpINT_IE = (uint32_t)CLIC_InitStructIRQ->CLIC_EnableIRQ;
  90              	    TmpINT    = (TmpINT_IE << 8) | (TmpINT_ATTR << 16) | (TmpINT_CTL << 24);
  91              	
  92              	    return TmpINT;
  93              	}
