 534              	/**
 535              	 * @brief  Set the trigger type and polarity for interrupt.
 536              	 * @note   The interrupt pending bit is undefined when switching from level-sensitive mode to edge-
 537              	 * @param  IRQn: Device specific interrupt number.
 538              	 * @param  Trigger: @ref CLIC_TriggerIRQ_TypeDef - specify the trigger type and polarity for interr
 539              	 * @return None.
 540              	 */
 541              	void CLIC_SetTriggerIRQ(IRQn_TypeDef IRQn, CLIC_TriggerIRQ_TypeDef Trigger)
 542              	{
 543              	    uint8_t TmpReg;
 544              	
 545              	    /* Check the parameters. */
 546              	    assert_param(IS_IRQ(IRQn));
 547              	    assert_param(IS_CLIC_TRIGGER_IRQ(Trigger));
 548              	
 549              	    TmpReg = CLIC->INT[(uint32_t)IRQn].ATTR & (uint8_t)~CLIC_INTxATTR_TRIG_Msk;
 550              	    TmpReg |= (uint8_t)Trigger;
 551              	    CLIC->INT[(uint32_t)IRQn].ATTR = TmpReg;
 552              	}
