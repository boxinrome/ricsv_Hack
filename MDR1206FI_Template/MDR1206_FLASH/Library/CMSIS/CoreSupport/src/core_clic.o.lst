 487              	/**
 488              	 * @brief  Enable vector mode for interrupt.
 489              	 * @param  IRQn: Device specific interrupt number.
 490              	 * @return None.
 491              	 */
 492              	void CLIC_EnableVectorModeIRQ(IRQn_TypeDef IRQn)
 493              	{
 494              	    /* Check the parameters. */
 495              	    assert_param(IS_IRQ(IRQn));
