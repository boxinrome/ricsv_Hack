 498              	}
 499              	
 500              	/**
 501              	 * @brief  Disable vector mode for interrupt.
 502              	 * @param  IRQn: Device specific interrupt number.
 503              	 * @return None.
 504              	 */
 505              	void CLIC_DisableVectorModeIRQ(IRQn_TypeDef IRQn)
 506              	{
 507              	    /* Check the parameters. */
 508              	    assert_param(IS_IRQ(IRQn));
