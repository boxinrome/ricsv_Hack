 313              	/**
 314              	 * @brief  Initialize the machine timer.
 315              	 * @note   In MDR32F02 rev 1.x: The cycle counter and core clock from SystemCoreClock are used for 
 316              	 *         Before calling this function, you must update SystemCoreClock by calling SystemCoreClock
 317              	 * @param  None.
 318              	 * @return @ref ErrorStatus - SUCCESS if initialized, else ERROR.
 319              	 */
 320              	ErrorStatus DELAY_MachineTimer_Init(void)
 321              	{
 322              	#if defined(USE_MDR32F02_REV_1X)
 323              	    uint32_t TempReg1, TempReg2, TempReg3;
 324              	
 325              	    /* Enable the BKP clock if it is disabled. */
 326              	    TempReg1 = MDR_RST_CLK->PER2_CLOCK;
 327              	    if ((TempReg1 & RST_CLK_PER2_CLOCK_PCLK_EN_BKP_Msk) == 0) {
 328              	        MDR_RST_CLK->PER2_CLOCK = TempReg1 | RST_CLK_PER2_CLOCK_PCLK_EN_BKP;
 329              	    }
 330              	
 331              	    /* Check the LSE_RDY flag. */
 332              	    TempReg2 = MDR_BKP->CLK;
 333              	    if ((TempReg2 & BKP_CLK_LSE_RDY_Msk) == 0) {
 334              	        /* Return error if LSE has been enabled but still is not ready. */
 335              	        if ((TempReg2 & BKP_CLK_LSE_ON_Msk) != 0) {
 336              	            return ERROR;
 337              	        }
 338              	
 339              	        /* Disable BKP write protection. */
 340              	        TempReg3 = MDR_BKP->WPR;
 341              	        if (TempReg3 != BKP_WPR_BKP_WPR_UNLOCK) {
 342              	            MDR_BKP->WPR = BKP_WPR_BKP_WPR_UNLOCK;
 343              	        }
 344              	        /* Enable the LSE clock. If it is rev.1 or rev.1.1, assume errata0001 has been taken
 345              	         into account and on-board LSE generator is used. */
 346              	        BKP_LSE_Config(BKP_LSE_BYPASS);
 347              	
 348              	        if (BKP_LSE_GetStatus() == ERROR) {
 349              	            return ERROR;
 350              	        }
 351              	
 352              	        /* Restore the BKP_WPR register value. */
 353              	        if (TempReg3 != BKP_WPR_BKP_WPR_UNLOCK) {
 354              	            MDR_BKP->WPR = TempReg3;
 355              	        }
 356              	    }
 357              	
 358              	    /* Restore the PER2_CLOCK register value. */
 359              	    if ((TempReg1 & RST_CLK_PER2_CLOCK_PCLK_EN_BKP_Msk) == 0) {
 360              	        MDR_RST_CLK->PER2_CLOCK = TempReg1;
 361              	    }
 362              	
 363              	#else
 364              	    MDR_RST_CLK->DIV_SYS_TIM = 0x00000000;
 365              	#endif
 366              	    return SUCCESS;
 367              	}
