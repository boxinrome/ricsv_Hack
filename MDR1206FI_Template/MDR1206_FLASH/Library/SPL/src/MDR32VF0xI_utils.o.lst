  41              	
  42              	static DELAY_Mode_TypeDef DelayMode = DELAY_MODE_PROGRAM;
  43              	
  44              	static uint32_t DelayConstUs = (uint32_t)(((uint64_t)HSI_FREQUENCY_Hz << 31) / (uint64_t)64000000);
  45              	static uint32_t DelayConstMs = (uint32_t)(((uint64_t)HSI_FREQUENCY_Hz << 31) / (uint64_t)65536000);
