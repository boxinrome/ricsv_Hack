 245              	#if defined(USE_MDR1206)
 246              	/**
 247              	 * @brief  Get microcontroller ID (215 or 217) for MDR1206.
 248              	 * @note   This function can be used only for MDR1206 microcontroller.
 249              	 * @param  None.
 250              	 * @return Microcontroller ID value.
 251              	 */
 252              	uint8_t GetChipID(void)
 253              	{
 254              	    uint32_t        Per2Clock;
 255              	    static uint32_t ChipID;
 256              	
 257              	    if (ChipID == 0) {
 258              	        Per2Clock = MDR_RST_CLK->PER2_CLOCK;
 259              	
 260              	        MDR_RST_CLK->PER2_CLOCK = Per2Clock | RST_CLK_PER2_CLOCK_PCLK_EN_FLASH;
 261              	        ChipID                  = MDR_FLASH->CHIP_ID_CTRL;
 262              	
 263              	        MDR_RST_CLK->PER2_CLOCK = Per2Clock;
 264              	
 265              	        ChipID = (ChipID & FLASH_CHIP_ID_CTRL_CHIP_ID_Msk) >> FLASH_CHIP_ID_CTRL_CHIP_ID_Pos;
 266              	    }
 267              	
 268              	    return (uint8_t)ChipID;
 269              	}
 270              	#endif
 271              	
 272              	/**
 273              	 * @brief  System reset using WWDG.
 274              	 * @note   Does not reset BKP domain and IWDG.
 275              	 * @param  WWDG_C2_Source: @ref RST_CLK_WWDG_C2_ClockSource_TypeDef - specify WWDG_C2 clock source.
 276              	 *         The selected WWDG_C2 clock source must be configured before calling WWDG_SystemReset().
 277              	 *         For a faster reset, it is recommended to select the highest frequency.
 278              	 * @return None.
 279              	 */
 280              	void WWDG_SystemReset(RST_CLK_WWDG_C2_ClockSource_TypeDef WWDG_C2_Source)
 281              	{
 282              	    uint32_t TmpReg;
 283              	
 284              	    /* Check the parameters. */
 285              	    assert_param(IS_RST_CLK_WWDG_C2_CLOCK_SOURCE(WWDG_C2_Source));
 286              	
 287              	    /* Enable WDG_CLK and PCLK for WWDG. */
 288              	    TmpReg = MDR_RST_CLK->PER1_CLOCK & ~(RST_CLK_PER1_CLOCK_WDG_C2_SEL_Msk | RST_CLK_PER1_CLOCK_WDG
 289              	    TmpReg |= (uint32_t)WWDG_C2_Source | RST_CLK_PER1_CLOCK_WDG_CLK_EN;
 290              	
 291              	    MDR_RST_CLK->PER1_CLOCK = TmpReg;
 292              	    MDR_RST_CLK->PER2_CLOCK |= RST_CLK_PER2_CLOCK_PCLK_EN_WWDG;
 293              	
 294              	    /* Configuration WWDG for reset: minimum window value and maximum counter value. */
 295              	    MDR_WWDG->CFR = 0x40;
 296              	    while ((MDR_WWDG->SR & WWDG_SR_WDG_WEC_Msk) == 0) { }
 297              	    MDR_WWDG->CR = WWDG_CR_WDGA_Msk | 0x7F;
 298              	    while ((MDR_WWDG->SR & WWDG_SR_WDG_WEC_Msk) == 0) { }
 299              	
 300              	    /* WWDG reload counter outside window, reset immediately by clock WWDG_CLK. */
 301              	    MDR_WWDG->CR = 0x7F;
 302              	
 303              	    /* Wait reset. */
 304              	    while (1) { }
 305              	}
