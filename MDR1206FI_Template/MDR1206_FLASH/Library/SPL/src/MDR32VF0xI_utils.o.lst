  64              	/**
  65              	 * @brief  Initialize the DELAY module according to a specified mode.
  66              	 * @note   The core clock from SystemCoreClock is used to calculate the delay time.
  67              	 *         You must configure the required core clock and call SystemCoreClockUpdate() before calli
  68              	 * @param  Mode: @ref DELAY_Mode_TypeDef - specify the delay mode.
  69              	 * @return @ref ErrorStatus - SUCCESS if initialized, else ERROR.
  70              	 */
  71              	ErrorStatus DELAY_Init(DELAY_Mode_TypeDef Mode)
  72              	{
  73              	    assert_param(IS_DELAY_MODE(Mode));
  74              	
  75              	    DelayMode = Mode;
  76              	
  77              	    switch (DelayMode) {
  78              	        case DELAY_MODE_PROGRAM:
  79              	            DelayConstUs = DELAY_PROGRAM_GET_CONST_US(SystemCoreClock);
  80              	            DelayConstMs = DELAY_PROGRAM_GET_CONST_MS(SystemCoreClock);
  81              	            break;
  82              	        case DELAY_MODE_MACHINE_TIMER:
  83              	#if defined(USE_MDR32F02_REV_1X)
  84              	            DelayConstUs = DELAY_MACHINE_TIMER_GET_CONST_US(LSE_FREQUENCY_Hz);
  85              	            DelayConstMs = DELAY_MACHINE_TIMER_GET_CONST_MS(LSE_FREQUENCY_Hz);
  86              	#else
  87              	            DelayConstUs = DELAY_MACHINE_TIMER_GET_CONST_US(SystemCoreClock / 2);
  88              	            DelayConstMs = DELAY_MACHINE_TIMER_GET_CONST_MS(SystemCoreClock / 2);
  89              	#endif
  90              	            return DELAY_MachineTimer_Init();
  91              	            break;
  92              	        case DELAY_MODE_CYCLE_COUNTER:
  93              	            DelayConstUs = DELAY_CYCLE_COUNTER_GET_CONST_US(SystemCoreClock);
  94              	            DelayConstMs = DELAY_CYCLE_COUNTER_GET_CONST_MS(SystemCoreClock);
  95              	            DELAY_CycleCounter_Init();
  96              	            break;
  97              	    }
  98              	    return SUCCESS;
  99              	}
 100              	
 101              	/**
 102              	 * @brief  Perform a blocking delay in microseconds.
 103              	 * @param  Us: Specify the delay time in microseconds.
 104              	 *         This parameter can be a value up to 2^26 = 67108864.
 105              	 * @return None.
 106              	 */
 107              	void DELAY_WaitUs(uint32_t Us)
 108              	{
 109              	    uint32_t DelayTicksUs;
 110              	
 111              	    DelayTicksUs = DELAY_GET_TICKS_US(Us, DelayConstUs);
 112              	
 113              	    switch (DelayMode) {
 114              	        case DELAY_MODE_PROGRAM:
 115              	            DELAY_PROGRAM_WaitLoopsAsm(DelayTicksUs);
 116              	            break;
 117              	        case DELAY_MODE_MACHINE_TIMER:
 118              	            DELAY_MachineTimer_WaitTicks(DelayTicksUs);
 119              	            break;
 120              	        case DELAY_MODE_CYCLE_COUNTER:
 121              	            DELAY_CycleCounter_WaitTicksAsm(DelayTicksUs);
 122              	            break;
 123              	    }
 124              	}
 125              	
 126              	/**
 127              	 * @brief  Perform a blocking delay in milliseconds.
 128              	 * @param  Ms: Specify the delay time in milliseconds.
 129              	 *         This parameter can be a value up to 2^32 / CPU_CLK (kHz), but not more than 2^18 = 26214
 130              	 * @return None.
 131              	 */
 132              	void DELAY_WaitMs(uint32_t Ms)
 133              	{
 134              	    uint32_t DelayTicksMs;
 135              	
 136              	    DelayTicksMs = DELAY_GET_TICKS_MS(Ms, DelayConstMs);
 137              	
 138              	    switch (DelayMode) {
 139              	        case DELAY_MODE_PROGRAM:
 140              	            DELAY_PROGRAM_WaitLoopsAsm(DelayTicksMs);
 141              	            break;
 142              	        case DELAY_MODE_MACHINE_TIMER:
 143              	            DELAY_MachineTimer_WaitTicks(DelayTicksMs);
 144              	            break;
 145              	        case DELAY_MODE_CYCLE_COUNTER:
 146              	            DELAY_CycleCounter_WaitTicksAsm(DelayTicksMs);
 147              	            break;
 148              	    }
 149              	}
