 151              	/**
 152              	 * @brief  Initialize trimmings according to factory data.
 153              	 * @note:  For MDR32F02 factory data is not validated with CRC, so trimmings will always be initial
 154              	 *         and function will always return SUCCESS.
 155              	 * @param  None.
 156              	 * @return @ref ErrorStatus - SUCCESS if initialized with factory data trimmings, ERROR if initiali
 157              	 */
 158              	ErrorStatus FactoryDataTrimInit(void)
 159              	{
 160              	    uint32_t Temp1, Temp2, Temp3;
 161              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI) || defined(USE_MDR1206)
 162              	    FLASH_FactoryData_TypeDef FactoryData;
 163              	    ErrorStatus               DataValid;
 164              	
 165              	    DataValid = FLASH_ReadFactoryData(&FactoryData);
 166              	    if (DataValid == SUCCESS) {
 167              	        Temp1                   = MDR_RST_CLK->PER2_CLOCK;
 168              	        MDR_RST_CLK->PER2_CLOCK = Temp1 | RST_CLK_PER2_CLOCK_PCLK_EN_BKP | RST_CLK_PER2_CLOCK_PCLK_
 169              	        Temp2                   = MDR_BKP->WPR;
 170              	        if (Temp2 != BKP_WPR_BKP_WPR_UNLOCK) {
 171              	            MDR_BKP->WPR = BKP_WPR_BKP_WPR_UNLOCK;
 172              	        }
 173              	
 174              	        Temp3 = MDR_BKP->CLK;
 175              	        Temp3 &= ~(BKP_CLK_HSI_LSI_TRIM_Msk);
 176              	        Temp3 |= ((FactoryData.TrimHSI << BKP_CLK_HSI_LSI_TRIM_Pos) & BKP_CLK_HSI_LSI_TRIM_Msk);
 177              	        MDR_BKP->CLK = Temp3;
 178              	
 179              	        Temp3 = MDR_BKP->LDO;
 180              	        Temp3 &= ~(BKP_LDO_LDO_BOOST_Msk | BKP_LDO_SW_OFF_Msk | BKP_LDO_TAMPF_Msk);
 181              	        Temp3 |= ((FactoryData.TrimLDO << BKP_LDO_LDO_BOOST_Pos) & BKP_LDO_LDO_BOOST_Msk);
 182              	        MDR_BKP->LDO = Temp3;
 183              	
 184              	        MDR_ADC->ADC_TRIM = ((FactoryData.TrimBG << ADC_TRIM_BG_TRIM_Pos) & ADC_TRIM_BG_TRIM_Msk);
 185              	
 186              	        if (Temp2 != BKP_WPR_BKP_WPR_UNLOCK) {
 187              	            MDR_BKP->WPR = Temp2;
 188              	        }
 189              	        MDR_RST_CLK->PER2_CLOCK = Temp1;
 190              	    } else {
 191              	#if defined(USE_MDR1206)
 192              	        if (GetChipID() == CHIP_ID_MDR1206FI) {
 193              	            FactoryData.TrimHSI = TRIM_HSI_MDR1206FI_VALUE_TYP;
 194              	            FactoryData.TrimBG  = TRIM_BG_MDR1206FI_VALUE_TYP;
 195              	        } else {
 196              	            FactoryData.TrimHSI = TRIM_HSI_MDR1206AFI_VALUE_TYP;
 197              	            FactoryData.TrimBG  = TRIM_BG_MDR1206AFI_VALUE_TYP;
 198              	        }
 199              	#elif defined(USE_MDR1206FI) || defined(USE_MDR1206AFI)
 200              	        FactoryData.TrimHSI = TRIM_HSI_VALUE_TYP;
 201              	        FactoryData.TrimBG  = TRIM_BG_VALUE_TYP;
 202              	#endif
 203              	
 204              	        Temp1                   = MDR_RST_CLK->PER2_CLOCK;
 205              	        MDR_RST_CLK->PER2_CLOCK = Temp1 | RST_CLK_PER2_CLOCK_PCLK_EN_BKP | RST_CLK_PER2_CLOCK_PCLK_
 206              	        Temp2                   = MDR_BKP->WPR;
 207              	        if (Temp2 != BKP_WPR_BKP_WPR_UNLOCK) {
 208              	            MDR_BKP->WPR = BKP_WPR_BKP_WPR_UNLOCK;
 209              	        }
 210              	
 211              	        Temp3 = MDR_BKP->CLK;
 212              	        Temp3 &= ~(BKP_CLK_HSI_LSI_TRIM_Msk);
 213              	        Temp3 |= ((FactoryData.TrimHSI << BKP_CLK_HSI_LSI_TRIM_Pos) & BKP_CLK_HSI_LSI_TRIM_Msk);
 214              	        MDR_BKP->CLK = Temp3;
 215              	
 216              	        MDR_ADC->ADC_TRIM = ((FactoryData.TrimBG << ADC_TRIM_BG_TRIM_Pos) & ADC_TRIM_BG_TRIM_Msk);
 217              	
 218              	        if (Temp2 != BKP_WPR_BKP_WPR_UNLOCK) {
 219              	            MDR_BKP->WPR = Temp2;
 220              	        }
 221              	        MDR_RST_CLK->PER2_CLOCK = Temp1;
 222              	    }
 223              	    return DataValid;
 224              	#elif defined(USE_MDR32F02)
 225              	    Temp1                   = MDR_RST_CLK->PER2_CLOCK;
 226              	    MDR_RST_CLK->PER2_CLOCK = Temp1 | RST_CLK_PER2_CLOCK_PCLK_EN_BKP;
 227              	    Temp2                   = MDR_BKP->WPR;
 228              	    if (Temp2 != BKP_WPR_BKP_WPR_UNLOCK) {
 229              	        MDR_BKP->WPR = BKP_WPR_BKP_WPR_UNLOCK;
 230              	    }
 231              	
 232              	    Temp3 = MDR_BKP->CLK;
 233              	    Temp3 &= ~(BKP_CLK_HSI_LSI_TRIM_Msk);
 234              	    Temp3 |= ((OTP_SPECIAL_FIELDS->HSI_TRIM << BKP_CLK_HSI_LSI_TRIM_Pos) & BKP_CLK_HSI_LSI_TRIM_Msk
 235              	    MDR_BKP->CLK = Temp3;
 236              	
 237              	    if (Temp2 != BKP_WPR_BKP_WPR_UNLOCK) {
 238              	        MDR_BKP->WPR = Temp2;
 239              	    }
 240              	    MDR_RST_CLK->PER2_CLOCK = Temp1;
 241              	    return SUCCESS;
 242              	#endif
 243              	}
