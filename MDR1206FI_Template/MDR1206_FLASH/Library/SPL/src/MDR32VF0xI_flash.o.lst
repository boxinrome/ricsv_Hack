 1404              	/**
 1405              	 * @brief   Program a 16-bit FLASH memory value.
 1406              	 * @warning To count the correct delay times, the core clock must be at least 8 MHz.
 1407              	 * @warning The same address (32-bit data) can't be programmed more than twice before next erase.
 1408              	 * @note    This function can be used only for MDR32F02 and MDR1206FI (ID = 217).
 1409              	 * @note    Hardware supports only 32-bit word programming.
 1410              	 * @note    The delay uses the cycle counter and core clock from SystemCoreClock. Do not disable th
 1411              	 *          Before calling FLASH_ProgramHalfWord(), you must update SystemCoreClock by calling Syst
 1412              	 * @param   Address: A FLASH memory half word address (two bytes aligned).
 1413              	 * @param   Data: 16-bit data to be programmed.
 1414              	 * @param   Bank: @ref FLASH_MemoryBank_TypeDef - select a FLASH bank (the main bank or the informa
 1415              	 *          This parameter can be one of the following values:
 1416              	 *              @arg FLASH_BANK_MAIN: The FLASH main bank;
 1417              	 *              @arg FLASH_BANK_INFO: The FLASH information bank.
 1418              	 * @return  None.
 1419              	 */
 1420              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI)
 1421              	void FLASH_ProgramHalfWord(uint32_t Address, uint16_t Data, FLASH_MemoryBank_TypeDef Bank)
 1422              	#elif defined(USE_MDR1206)
 1423              	/** @cond */
 1424              	static void FLASH_ProgramHalfWord_ID217(uint32_t Address, uint16_t Data, FLASH_MemoryBank_TypeDef B
 1425              	/** @endcond */
 1426              	#endif
 1427              	{
 1428              	    uint32_t Mask;
 1429              	    uint32_t Tmp;
 1430              	    uint32_t Shift;
 1431              	    uint32_t ProgData;
 1432              	
 1433              	    /* Check the parameters. */
 1434              	    assert_param(IS_FLASH_ADDR_TWO_BYTE_ALIGNED(Address));
 1435              	    assert_param(IS_FLASH_MEMORY_BANK(Bank));
 1436              	
 1437              	    Shift    = (Address & FLASH_ADDR_HALFWORD_MASK) * 8;
 1438              	    ProgData = (uint32_t)Data << Shift;
 1439              	    Mask     = (uint32_t)0xFFFF << Shift;
 1440              	    Address &= ~FLASH_ADDR_FOUR_BYTE_ALIGN_MASK;
 1441              	
 1442              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI)
 1443              	    Tmp      = FLASH_ReadWord(Address, Bank);
 1444              	    ProgData = (Tmp & ~Mask) | (ProgData & Mask);
 1445              	    FLASH_ProgramWord(Address, ProgData, Bank);
 1446              	#elif defined(USE_MDR1206)
 1447              	    Tmp      = FLASH_ReadWord_ID217(Address, Bank);
 1448              	    ProgData = (Tmp & ~Mask) | (ProgData & Mask);
 1449              	    FLASH_ProgramWord_ID217(Address, ProgData, Bank);
 1450              	#endif
 1451              	}
