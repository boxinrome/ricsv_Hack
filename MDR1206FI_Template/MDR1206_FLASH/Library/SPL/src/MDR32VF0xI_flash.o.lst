  40              	/**
  41              	 * @brief FLASH program size. Only used for MDR1206AFI (ID = 215).
  42              	 */
  43              	typedef enum {
  44              	    FLASH_PROGRAM_SIZE_1BYTE = (uint32_t)(0x01), /*!< Select 1 byte to programming. */
  45              	    FLASH_PROGRAM_SIZE_2BYTE = (uint32_t)(0x02), /*!< Select 2 bytes to programming. */
  46              	    FLASH_PROGRAM_SIZE_4BYTE = (uint32_t)(0x04)  /*!< Select 4 bytes to programming. */
  47              	} FLASH_ProgramSize_TypeDef;
  48              	
  49              	#define IS_FLASH_PROGRAM_SIZE(SIZE) (((SIZE) == FLASH_PROGRAM_SIZE_1BYTE) || \
  50              	                                     ((SIZE) == FLASH_PROGRAM_SIZE_2BYTE) || \
  51              	                                     ((SIZE) == FLASH_PROGRAM_SIZE_4BYTE))
  52              	#endif
  53              	
  54              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI) || defined(USE_MDR1206)
  55              	/**
  56              	 * @brief FLASH memory banks for mass erase.
  57              	 */
  58              	typedef enum {
  59              	    FLASH_ERASE_BANK_MAIN = ((uint32_t)0x00), /*!< Select the FLASH main bank to erase. */
  60              	    FLASH_ERASE_BANK_ALL  = ((uint32_t)0x01)  /*!< Select the FLASH main and information banks to e
  61              	} FLASH_EraseMemoryBank_TypeDef;
  62              	
  63              	#define IS_FLASH_ERASE_BANK(BANK) (((BANK) == FLASH_ERASE_BANK_MAIN) || \
  64              	                                   ((BANK) == FLASH_ERASE_BANK_ALL))
  65              	#endif
