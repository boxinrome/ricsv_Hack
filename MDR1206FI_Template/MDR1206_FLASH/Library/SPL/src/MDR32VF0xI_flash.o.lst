 975              	/**
 976              	 * @brief  Read a 16-bit FLASH memory value.
 977              	 * @note   Hardware supports only 32-bit word reading.
 978              	 * @param  Address: The FLASH memory half word address (two bytes aligned).
 979              	 * @param  Bank: @ref FLASH_MemoryBank_TypeDef - select a FLASH bank (the main bank or the informat
 980              	 *         This parameter can be one of the following values:
 981              	 *             @arg FLASH_BANK_MAIN: The FLASH main bank;
 982              	 *             @arg FLASH_BANK_INFO: The FLASH information bank.
 983              	 * @return The selected FLASH memory halfword.
 984              	 */
 985              	uint16_t FLASH_ReadHalfWord(uint32_t Address, FLASH_MemoryBank_TypeDef Bank)
 986              	{
 987              	    uint32_t Data;
 988              	    uint32_t Shift;
 989              	
 990              	    /* Check the parameters. */
 991              	    assert_param(IS_FLASH_MEMORY_BANK(Bank));
 992              	    assert_param(IS_FLASH_ADDR_TWO_BYTE_ALIGNED(Address));
 993              	
 994              	    Data = FLASH_ReadWord(Address & ~FLASH_ADDR_FOUR_BYTE_ALIGN_MASK, Bank);
 995              	
 996              	    Shift = (Address & FLASH_ADDR_HALFWORD_MASK) * 8;
 997              	    Data >>= Shift;
 998              	
 999              	    return (uint16_t)Data;
 1000              	}
