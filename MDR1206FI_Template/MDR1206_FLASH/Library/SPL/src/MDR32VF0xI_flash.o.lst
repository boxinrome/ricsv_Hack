 923              	/**
 924              	 * @brief  Set a FLASH latency value. Unlocking FLASH is not required before calling this function.
 925              	 * @param  Latency: @ref FLASH_Latency_TypeDef - specify a FLASH latency value in cycles.
 926              	 * @return None.
 927              	 */
 928              	void FLASH_SetLatency(FLASH_Latency_TypeDef Latency)
 929              	{
 930              	    /* Check the parameters. */
 931              	    assert_param(IS_FLASH_LATENCY(Latency));
 932              	
 933              	    /* Set the new latency value. */
 934              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI)
 935              	    MDR_FLASH->CMD = (uint32_t)Latency | FLASH_CMD_TMR;
 936              	#elif defined(USE_MDR1206)
 937              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 938              	        MDR_FLASH->CMD = (uint32_t)Latency | FLASH_CMD_TMR;
 939              	    }
 940              	#endif
 941              	#if defined(USE_MDR32F02)
 942              	    *((volatile uint32_t*)FLASH_BASE); /* Errata 0011 workaround. */
 943              	#endif
 944              	}
 945              	
 946              	/**
 947              	 * @brief  Get a FLASH latency value. Unlocking FLASH is not required before calling this function.
 948              	 * @param  None.
 949              	 * @return @ref FLASH_Latency_TypeDef - a FLASH latency value in cycles.
 950              	 */
 951              	FLASH_Latency_TypeDef FLASH_GetLatency(void)
 952              	{
 953              	#if defined(USE_MDR1206)
 954              	    FLASH_Latency_TypeDef Latency = FLASH_LATENCY_CYCLE_1;
 955              	
 956              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 957              	        Latency = (FLASH_Latency_TypeDef)(MDR_FLASH->CMD & FLASH_CMD_DELAY_Msk);
 958              	    }
 959              	#endif
 960              	    /* Return the current latency value. */
 961              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI)
 962              	    return (FLASH_Latency_TypeDef)(MDR_FLASH->CMD & FLASH_CMD_DELAY_Msk);
 963              	#elif defined(USE_MDR1206)
 964              	    return Latency;
 965              	#endif
 966              	}
