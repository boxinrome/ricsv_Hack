 218              	/**
 219              	 * @brief  Get the FLASH page number for the information bank.
 220              	 * @param  PageAddress: The FLASH page address.
 221              	 * @return The FLASH page number for the selected address.
 222              	 */
 223              	static uint32_t FLASH_GetInfoPageNumber(uint32_t PageAddress)
 224              	{
 225              	    uint32_t PageNumber;
 226              	
 227              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI)
 228              	    PageNumber = FLASH_GET_INFO_PAGE_NUMBER(PageAddress);
 229              	#elif defined(USE_MDR1206)
 230              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 231              	        PageNumber = FLASH_GET_INFO_PAGE_NUMBER_ID217(PageAddress);
 232              	    } else {
 233              	        PageNumber = FLASH_GET_INFO_PAGE_NUMBER_ID215(PageAddress);
 234              	    }
 235              	#endif
 236              	
 237              	    return PageNumber;
 238              	}
 239              	#endif
 240              	#endif
