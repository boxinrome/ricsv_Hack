 531              	/** @addtogroup FLASH_Exported_Functions FLASH Exported Functions
 532              	 * @{
 533              	 */
 534              	
 535              	/** @addtogroup FLASH_Exported_Functions_Allowed_to_Be_Located_in_FLASH Functions Allowed to Be Loc
 536              	 * @{
 537              	 */
 538              	
 539              	/** @addtogroup FLASH_Exported_Control_Functions_Allowed_to_Be_Located_in_FLASH FLASH Control Funct
 540              	 * @{
 541              	 */
 542              	
 543              	/**
 544              	 * @brief  Lock/Unlock access to FLASH memory via registers (locked by default).
 545              	 * @param  LockState: @ref FlagStatus - a new lock state of the access to FLASH memory via register
 546              	 *         This parameter must be one of the @ref FlagStatus values:
 547              	 *             @arg RESET: Unlock the access;
 548              	 *             @arg SET: Lock the access.
 549              	 * @return None.
 550              	 */
 551              	void FLASH_SetRegistersLock(FlagStatus LockState)
 552              	{
 553              	    /* Check the parameters. */
 554              	    assert_param(IS_BIT_STATUS(LockState));
 555              	
 556              	    if (LockState != RESET) {
 557              	        /* Lock access if SET. */
 558              	        MDR_FLASH->KEY = FLASH_KEY_KEY_LOCK;
 559              	    } else {
 560              	        /* Unlock access if RESET. */
 561              	        MDR_FLASH->KEY = FLASH_KEY_KEY_UNLOCK;
 562              	    }
 563              	}
 564              	
 565              	/**
 566              	 * @brief  Get the current state of access to FLASH memory via registers (locked by default).
 567              	 * @param  None.
 568              	 * @return @ref FlagStatus - lock state:
 569              	 *             @arg RESET: Unlocked;
 570              	 *             @arg SET: Locked.
 571              	 */
 572              	FlagStatus FLASH_GetRegistersLock(void)
 573              	{
 574              	    if (MDR_FLASH->KEY == FLASH_KEY_KEY_UNLOCK) {
 575              	        /* Access to FLASH memory via registers is unlocked. */
 576              	        return RESET;
 577              	    } else {
 578              	        /* Access to FLASH memory via registers is locked. */
 579              	        return SET;
 580              	    }
 581              	}
 582              	
 583              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI) || defined(USE_MDR1206)
 584              	/**
 585              	 * @brief  Get microcontroller ID for MDR1206FI (ID = 217) and MDR1206AFI (ID = 215).
 586              	 * @param  None.
 587              	 * @return Microcontroller ID value.
 588              	 */
 589              	uint8_t FLASH_GetChipID(void)
 590              	{
 591              	    uint32_t ChipID;
 592              	
 593              	    ChipID = MDR_FLASH->CHIP_ID_CTRL;
 594              	    ChipID = (ChipID & FLASH_CHIP_ID_CTRL_CHIP_ID_Msk) >> FLASH_CHIP_ID_CTRL_CHIP_ID_Pos;
 595              	
 596              	    return (uint8_t)ChipID;
 597              	}
 598              	#endif
