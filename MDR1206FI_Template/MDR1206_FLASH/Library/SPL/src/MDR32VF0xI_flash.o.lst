 856              	/**
 857              	 * @brief  Get the FLASH page address (can be used for FLASH_ErasePage()).
 858              	 * @param  PageNumber: The FLASH page number.
 859              	 *         This parameter is a value:
 860              	 *         - MDR32F02: main bank - from 0 to 63, information bank - from 0 to 1;
 861              	 *         - MDR1206FI: main bank - from 0 to 127, information bank - from 0 to 3;
 862              	 *         - MDR1206AFI: main bank - from 0 to 511, information bank - from 0 to 14.
 863              	 * @param  Bank: @ref FLASH_MemoryBank_TypeDef - select a FLASH bank (the main bank or the informat
 864              	 *         This parameter can be one of the following values:
 865              	 *             @arg FLASH_BANK_MAIN: The FLASH main bank;
 866              	 *             @arg FLASH_BANK_INFO: The FLASH information bank.
 867              	 * @return The address of selected FLASH page.
 868              	 */
 869              	uint32_t FLASH_GetPageAddress(uint32_t PageNumber, FLASH_MemoryBank_TypeDef Bank)
 870              	{
 871              	    uint32_t PageAddress;
 872              	
 873              	    /* Check the parameters. */
 874              	    assert_param(IS_FLASH_MEMORY_BANK(Bank));
 875              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI) || defined(USE_MDR1206AFI)
 876              	    assert_param((Bank == FLASH_BANK_MAIN) ? IS_FLASH_MAIN_PAGE_NUMBER(PageNumber) : IS_FLASH_INFO_
 877              	#elif defined(USE_MDR1206)
 878              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 879              	        assert_param((Bank == FLASH_BANK_MAIN) ? IS_FLASH_MAIN_PAGE_NUMBER_ID217(PageNumber) : IS_F
 880              	    } else {
 881              	        assert_param((Bank == FLASH_BANK_MAIN) ? IS_FLASH_MAIN_PAGE_NUMBER_ID215(PageNumber) : IS_F
 882              	    }
 883              	#endif
 884              	
 885              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI) || defined(USE_MDR1206AFI)
 886              	    if (Bank == FLASH_BANK_MAIN) {
 887              	        PageAddress = FLASH_GET_MAIN_PAGE_ADDR(PageNumber);
 888              	    } else {
 889              	        PageAddress = FLASH_GET_INFO_PAGE_ADDR(PageNumber);
 890              	    }
 891              	#elif defined(USE_MDR1206)
 892              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 893              	        if (Bank == FLASH_BANK_MAIN) {
 894              	            PageAddress = FLASH_GET_MAIN_PAGE_ADDR_ID217(PageNumber);
 895              	        } else {
 896              	            PageAddress = FLASH_GET_INFO_PAGE_ADDR_ID217(PageNumber);
 897              	        }
 898              	    } else {
 899              	        if (Bank == FLASH_BANK_MAIN) {
 900              	            PageAddress = FLASH_GET_MAIN_PAGE_ADDR_ID215(PageNumber);
 901              	        } else {
 902              	            PageAddress = FLASH_GET_INFO_PAGE_ADDR_ID215(PageNumber);
 903              	        }
 904              	    }
 905              	#endif
 906              	
 907              	    return PageAddress;
 908              	}
