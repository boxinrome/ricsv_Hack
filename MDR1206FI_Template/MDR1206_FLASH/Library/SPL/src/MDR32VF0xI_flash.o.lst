 3693              	# 2142 "../Library/SPL/src/MDR32VF0xI_flash.c" 1
 1859              	
 1860              	/**
 1861              	 * @brief  Erase one page (1 KByte) of a selected FLASH memory bank.
 1862              	 * @note   This function can be used only for MDR1206AFI (ID = 215).
 1863              	 * @note   The delay uses the cycle counter and core clock from SystemCoreClock. Do not disable the
 1864              	 *         Before calling FLASH_ErasePage(), you must update SystemCoreClock by calling SystemCoreC
 1865              	 * @param  Address: Page address in the FLASH memory.
 1866              	 * @param  Bank: @ref FLASH_MemoryBank_TypeDef - select a FLASH bank (the main bank or the informat
 1867              	 *         This parameter can be one of the following values:
 1868              	 *             @arg FLASH_BANK_MAIN: The FLASH main bank;
 1869              	 *             @arg FLASH_BANK_INFO: The FLASH information bank.
 1870              	 * @return None.
 1871              	 */
 1872              	#if defined(USE_MDR1206AFI)
 1873              	void FLASH_ErasePage(uint32_t Address, FLASH_MemoryBank_TypeDef Bank)
 1874              	#elif defined(USE_MDR1206)
 1875              	/** @cond */
 1876              	static void FLASH_ErasePage_ID215(uint32_t Address, FLASH_MemoryBank_TypeDef Bank)
 1877              	/** @endcond */
 1878              	#endif
 1879              	{
 1880              	    uint32_t Command;
 1881              	    uint32_t DelayConst;
 1882              	    uint32_t Sector;
 1883              	    uint32_t MStatus;
 1884              	
 1885              	    /* Check the parameters. */
 1886              	    assert_param(IS_FLASH_MEMORY_BANK(Bank));
 1887              	
 1888              	#if defined(USE_FACTORY_DATA_PROTECTION)
 1889              	    if (Bank == FLASH_BANK_INFO) {
 1890              	        if (FLASH_GetInfoPageNumber(Address) == FLASH_FACTORY_DATA_PAGE_NUMBER_ID215) {
 1891              	            return;
 1892              	        }
 1893              	    }
 1894              	#endif
 1895              	
 1896              	    DelayConst = DELAY_CYCLE_COUNTER_GET_CONST_US(SystemCoreClock);
 1897              	
 1898              	    MStatus = CSR_ReadClearBits(CSR_MSTATUS, CSR_MSTATUS_MIE);
 1899              	    Command = FLASH_CMD_CON | FLASH_CMD_TMEN;
 1900              	    Command |= (Bank == FLASH_BANK_INFO) ? FLASH_CMD_NVR : 0;
 1901              	    MDR_FLASH->CMD = Command;
 1902              	
 1903              	    for (Sector = 0; Sector < 2; Sector++) {
 1904              	        Address        = (Address & ~FLASH_ADDR_SECTOR_MASK) | (Sector << FLASH_ADDR_SECTOR_POS);
 1905              	        MDR_FLASH->ADR = FLASH_ConvertAddress(Address, Bank);
 1906              	
 1907              	        Command |= FLASH_CMD_CE | FLASH_CMD_ERASE;
 1908              	        MDR_FLASH->CMD = Command;
 1909              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TNVS_SECTOR_ERASE_US, DelayConst))
 1910              	
 1911              	        Command |= FLASH_CMD_WE;
 1912              	        MDR_FLASH->CMD = Command;
 1913              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TERASE_SECTOR_ERASE_US, DelayConst
 1914              	
 1915              	        Command &= ~FLASH_CMD_WE;
 1916              	        MDR_FLASH->CMD = Command;
 1917              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TRCV_SECTOR_ERASE_US, DelayConst))
 1918              	
 1919              	        Command &= ~(FLASH_CMD_CE | FLASH_CMD_ERASE);
 1920              	        MDR_FLASH->CMD = Command;
 1921              	    }
 1922              	    MDR_FLASH->CMD = FLASH_CMD_TMEN;
 1923              	
 1924              	    DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TRW_SECTOR_ERASE_US, DelayConst));
 1925              	    CSR_Write(CSR_MSTATUS, MStatus);
 1926              	}
 1927              	
 1928              	/**
 1929              	 * @brief  Erase all pages of a selected FLASH memory bank.
 1930              	 * @note   This function can be used only for MDR1206AFI (ID = 215).
 1931              	 * @param  Bank: @ref FLASH_MemoryBank_TypeDef - select a FLASH bank.
 1932              	 *         This parameter can be one of the following values:
 1933              	 *             @arg FLASH_BANK_MAIN: The FLASH main bank;
 1934              	 *             @arg FLASH_BANK_INFO: The FLASH information bank.
 1935              	 * @return None.
 1936              	 */
 1937              	#if defined(USE_MDR1206AFI)
 1938              	void FLASH_EraseAllPages(FLASH_MemoryBank_TypeDef Bank)
 1939              	#elif defined(USE_MDR1206)
 1940              	/** @cond */
 1941              	static void FLASH_EraseAllPages_ID215(FLASH_MemoryBank_TypeDef Bank)
 1942              	/** @endcond */
 1943              	#endif
 1944              	{
 1945              	    uint32_t Page;
 1946              	
 1947              	    /* Check the parameters. */
 1948              	    assert_param(IS_FLASH_MEMORY_BANK(Bank));
 1949              	
 1950              	#if defined(USE_MDR1206AFI)
 1951              	    if (Bank == FLASH_BANK_MAIN) {
 1952              	        FLASH_MassErase();
 1953              	    } else { /* (Bank == FLASH_BANK_INFO) */
 1954              	        for (Page = 0; Page < 15; Page++) {
 1955              	            FLASH_ErasePage(FLASH_GET_INFO_PAGE_ADDR(Page), FLASH_BANK_INFO);
 1956              	        }
 1957              	    }
 1958              	#elif defined(USE_MDR1206)
 1959              	    if (Bank == FLASH_BANK_MAIN) {
 1960              	        FLASH_MassErase_ID215();
 1961              	    } else { /* (Bank == FLASH_BANK_INFO) */
 1962              	        for (Page = 0; Page < 15; Page++) {
 1963              	            FLASH_ErasePage_ID215(FLASH_GET_INFO_PAGE_ADDR_ID215(Page), FLASH_BANK_INFO);
 1964              	        }
 1965              	    }
 1966              	#endif
 1967              	}
