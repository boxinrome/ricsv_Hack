 1969              	/**
 1970              	 * @brief  Erase the main and the information banks.
 1971              	 * @note   This function can be used only for MDR1206AFI (ID = 215).
 1972              	 * @param  None.
 1973              	 * @return None.
 1974              	 */
 1975              	#if defined(USE_MDR1206AFI)
 1976              	void FLASH_EraseAllBanks(void)
 1977              	#elif defined(USE_MDR1206)
 1978              	/** @cond */
 1979              	static void FLASH_EraseAllBanks_ID215(void)
 1980              	/** @endcond */
 1981              	#endif
 1982              	{
