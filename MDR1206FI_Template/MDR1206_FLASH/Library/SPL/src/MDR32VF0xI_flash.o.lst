 602              	/** @addtogroup FLASH_Exported_Special_Fields_Control_Functions_Allowed_to_Be_Located_in_FLASH FLAS
 603              	 * @{
 604              	 */
 605              	
 606              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI) || defined(USE_MDR1206)
 607              	/**
 608              	 * @brief   Program protection bits for selected FLASH memory regions.
 609              	 * @warning After programming the JTAG interface is blocked.
 610              	 * @param   ProtectionRegions: Protection regions.
 611              	 *          This parameter must be any combination of @ref FLASH_ProtectionRegions_TypeDef values.
 612              	 * @return  None.
 613              	 */
 614              	void FLASH_ProgramProtection(uint32_t ProtectionRegions)
 615              	{
 616              	    uint32_t Protection;
 617              	    uint32_t ProtectionAddr;
 618              	
 619              	    /* Check the parameters. */
 620              	    assert_param(IS_FLASH_PROTECTION_REGIONS(ProtectionRegions));
 621              	
 622              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI)
 623              	    ProtectionAddr = (uint32_t)&MDR_FLASH_SPECIAL_FIELDS->PROTECTION;
 624              	#elif defined(USE_MDR1206)
 625              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 626              	        ProtectionAddr = (uint32_t)&MDR_FLASH_SPECIAL_FIELDS_MDR1206FI->PROTECTION;
 627              	    } else {
 628              	        ProtectionAddr = (uint32_t)&MDR_FLASH_SPECIAL_FIELDS_MDR1206AFI->PROTECTION;
 629              	    }
 630              	#endif
 631              	
 632              	    Protection = FLASH_SPECIAL_FIELDS_PROTECTION_KEY_UNLOCK | (~ProtectionRegions & FLASH_SPECIAL_F
 633              	    FLASH_ProgramWord(ProtectionAddr, Protection, FLASH_BANK_INFO);
 634              	}
 635              	
 636              	/**
 637              	 * @brief  Read protection state of the FLASH memory regions.
 638              	 * @param  None.
 639              	 * @return A combined value of the individual protection states (@ref FLASH_ProtectionRegions_TypeD
 640              	 */
 641              	uint32_t FLASH_ReadProtection(void)
 642              	{
 643              	    uint32_t Protection;
 644              	
 645              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI)
 646              	    Protection = MDR_FLASH_SPECIAL_FIELDS->PROTECTION;
 647              	#elif defined(USE_MDR1206)
 648              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 649              	        Protection = MDR_FLASH_SPECIAL_FIELDS_MDR1206FI->PROTECTION;
 650              	    } else {
 651              	        Protection = MDR_FLASH_SPECIAL_FIELDS_MDR1206AFI->PROTECTION;
 652              	    }
 653              	#endif
 654              	
 655              	    if ((Protection & FLASH_SPECIAL_FIELDS_PROTECTION_KEY_Msk) == FLASH_SPECIAL_FIELDS_PROTECTION_K
 656              	        Protection = ~Protection & FLASH_SPECIAL_FIELDS_PROTECTION_REGIONS_Msk;
 657              	    } else {
 658              	        Protection = 0;
 659              	    }
 660              	
 661              	    return Protection;
 662              	}
 663              	
 664              	/**
 665              	 * @brief  Program factory data (UNIQUE_ID, TRIMs) and checksum (TRIM_CS) into FLASH memory.
 666              	 * @note   If USE_FACTORY_DATA_PROTECTION is defined, then factory data programming is not performe
 667              	 * @param  FactoryData: The pointer to the @ref FLASH_FactoryData_TypeDef structure
 668              	 *         that contains identification information and trim values.
 669              	 * @return None.
 670              	 */
 671              	void FLASH_ProgramFactoryData(const FLASH_FactoryData_TypeDef* FactoryData)
 672              	{
 673              	    uint32_t                         TrimWord;
 674              	    uint8_t                          TrimCS;
 675              	    uint32_t                         Index;
 676              	    const uint8_t*                   PtrFactoryData;
 677              	    MDR_FLASH_SpecialFields_TypeDef* FlashFactoryData;
 678              	
 679              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI)
 680              	    FlashFactoryData = MDR_FLASH_SPECIAL_FIELDS;
 681              	#elif defined(USE_MDR1206)
 682              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 683              	        FlashFactoryData = MDR_FLASH_SPECIAL_FIELDS_MDR1206FI;
 684              	    } else {
 685              	        FlashFactoryData = MDR_FLASH_SPECIAL_FIELDS_MDR1206AFI;
 686              	    }
 687              	#endif
 688              	    TrimWord = *((const uint32_t*)&FactoryData->TrimHSI);
 689              	
 690              	    /* Checksum calculation. */
 691              	    PtrFactoryData = (const uint8_t*)FactoryData;
 692              	    for (TrimCS = 0, Index = 0; Index < 24; Index++) {
 693              	        TrimCS += PtrFactoryData[Index];
 694              	    }
 695              	
 696              	    /* Program UNIQUE_ID, TRIMs and checksum (TRIM_CS) into FLASH memory. */
 697              	    for (Index = 0; Index < 5; Index++) {
 698              	        FLASH_ProgramWord((uint32_t)&FlashFactoryData->UNIQUE_ID[Index], FactoryData->UniqueID[Inde
 699              	    }
 700              	    FLASH_ProgramWord((uint32_t)&FlashFactoryData->TRIM_HSI, TrimWord, FLASH_BANK_INFO);
 701              	    FLASH_ProgramByte((uint32_t)&FlashFactoryData->TRIM_CS, TrimCS, FLASH_BANK_INFO);
 702              	}
 703              	
 704              	/**
 705              	 * @brief  Read factory data (UNIQUE_ID, TRIMs) from FLASH memory and verify the checksum (TRIM_CS)
 706              	 * @param  FactoryData: The pointer to the @ref FLASH_FactoryData_TypeDef structure
 707              	 *         where identification information and trim values should be stored.
 708              	 * @return @ref ErrorStatus - checksum verification result.
 709              	 */
 710              	ErrorStatus FLASH_ReadFactoryData(FLASH_FactoryData_TypeDef* FactoryData)
 711              	{
 712              	    uint8_t                          ReadTrimCS;
 713              	    uint8_t                          CalcTrimCS;
 714              	    uint32_t                         Index;
 715              	    uint8_t*                         PtrFactoryData;
 716              	    MDR_FLASH_SpecialFields_TypeDef* FlashFactoryData;
 717              	
 718              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI)
 719              	    FlashFactoryData = MDR_FLASH_SPECIAL_FIELDS;
 720              	#elif defined(USE_MDR1206)
 721              	    if (GetChipID() == CHIP_ID_MDR1206FI) {
 722              	        FlashFactoryData = MDR_FLASH_SPECIAL_FIELDS_MDR1206FI;
 723              	    } else {
 724              	        FlashFactoryData = MDR_FLASH_SPECIAL_FIELDS_MDR1206AFI;
 725              	    }
 726              	#endif
 727              	
 728              	    /* Read UNIQUE_ID, TRIMs and checksum (TRIM_CS) from FLASH memory. */
 729              	    for (Index = 0; Index < 5; Index++) {
 730              	        FactoryData->UniqueID[Index] = FlashFactoryData->UNIQUE_ID[Index];
 731              	    }
 732              	    *((uint32_t*)&FactoryData->TrimHSI) = *((uint32_t*)&FlashFactoryData->TRIM_HSI);
 733              	    ReadTrimCS                          = FlashFactoryData->TRIM_CS;
 734              	
 735              	    /* Checksum calculation. */
 736              	    PtrFactoryData = (uint8_t*)FactoryData;
 737              	    for (CalcTrimCS = 0, Index = 0; Index < 24; Index++) {
 738              	        CalcTrimCS += PtrFactoryData[Index];
 739              	    }
 740              	
 741              	    /* Comparison of checksums. */
 742              	    if (ReadTrimCS != CalcTrimCS) {
 743              	        return ERROR;
 744              	    } else {
 745              	        return SUCCESS;
 746              	    }
 747              	}
 748              	#endif
 749              	
 750              	/** @} */ /* End of the group FLASH_Exported_Special_Fields_Control_Functions_Allowed_to_Be_Located
 751              	
 752              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206AFI) || defined(USE_MDR1206)
 753              	/** @addtogroup FLASH_Exported_JTAG_Locking_Functions_Allowed_to_Be_Located_in_FLASH FLASH JTAG Loc
 754              	 * @{
 755              	 */
 756              	
 757              	/**
 758              	 * @brief  Lock/Unlock write access to the CHIP_ID_CTRL register that performs JTAG blocking.
 759              	 *         The CHIP_ID_CTRL register are locked by default.
 760              	 * @param  LockState: @ref FlagStatus - a new lock state of the CHIP_ID_CTRL register.
 761              	 *         This parameter must be one of the @ref FlagStatus values:
 762              	 *             @arg RESET: Unlock the write access;
 763              	 *             @arg SET: Lock the write access.
 764              	 * @return None.
 765              	 */
 766              	void FLASH_JTAG_SetRegistersLock(FlagStatus LockState)
 767              	{
 768              	    /* Check the parameters. */
 769              	    assert_param(IS_BIT_STATUS(LockState));
 770              	
 771              	    if (LockState != RESET) {
 772              	        /* Lock write access if SET. */
 773              	        MDR_FLASH->OTP_KEY = FLASH_OTP_KEY_OTP_KEY_LOCK;
 774              	    } else {
 775              	        /* Unlock write access if RESET. */
 776              	        MDR_FLASH->OTP_KEY = FLASH_OTP_KEY_OTP_KEY_UNLOCK;
 777              	    }
 778              	}
 779              	
 780              	/**
 781              	 * @brief  Get the current CHIP_ID_CTRL register write access lock state.
 782              	 *         The CHIP_ID_CTRL register are locked by default.
 783              	 * @param  None.
 784              	 * @return @ref FlagStatus - write lock state:
 785              	 *             @arg RESET: Unlocked;
 786              	 *             @arg SET: Locked.
 787              	 */
 788              	FlagStatus FLASH_JTAG_GetRegistersLock(void)
 789              	{
 790              	    if (MDR_FLASH->OTP_KEY == FLASH_OTP_KEY_OTP_KEY_UNLOCK) {
 791              	        /* CHIP_ID_CTRL write access is unlocked. */
 792              	        return RESET;
 793              	    } else {
 794              	        /* CHIP_ID_CTRL write access is locked. */
 795              	        return SET;
 796              	    }
 797              	}
 798              	
 799              	/**
 800              	 * @brief   Lock the JTAG interface permanently by programming the OTP memory.
 801              	 * @warning After programming the OTP memory, the JTAG interface will be locked forever.
 802              	 * @note    Available in microcontrollers since rev. 2.0.
 803              	 * @note    The delay uses the cycle counter and core clock from SystemCoreClock. Do not disable th
 804              	 *          Before calling FLASH_JTAG_SetLockForever(), you must update SystemCoreClock by calling 
 805              	 * @param   None.
 806              	 * @return  None.
 807              	 */
 808              	void FLASH_JTAG_SetLockForever(void)
 809              	{
 810              	    uint32_t Iteration;
 811              	    uint32_t OTPProg;
 812              	    uint32_t DelayConst;
 813              	    uint32_t MStatus;
 814              	
 815              	    OTPProg    = FLASH_CHIP_ID_CTRL_OTP_PROG;
 816              	    DelayConst = DELAY_CYCLE_COUNTER_GET_CONST_MS(SystemCoreClock);
 817              	
 818              	    MStatus                 = CSR_ReadClearBits(CSR_MSTATUS, CSR_MSTATUS_MIE);
 819              	    MDR_FLASH->CHIP_ID_CTRL = OTPProg;
 820              	    for (Iteration = 0; Iteration < 5; Iteration++) {
 821              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_MS(1, DelayConst));
 822              	        OTPProg ^= FLASH_CHIP_ID_CTRL_OTP_PROG;
 823              	        MDR_FLASH->CHIP_ID_CTRL = OTPProg;
 824              	    }
 825              	    CSR_Write(CSR_MSTATUS, MStatus);
 826              	}
 827              	
 828              	/**
 829              	 * @brief  Get the JTAG interface lock status.
 830              	 * @note   Available in microcontrollers since rev. 2.0.
 831              	 * @param  None.
 832              	 * @return @ref FlagStatus - JTAG interface lock status:
 833              	 *             @arg RESET: Unlocked;
 834              	 *             @arg SET: Locked.
 835              	 */
 836              	FlagStatus FLASH_JTAG_GetLockStatus(void)
 837              	{
 838              	    FlagStatus Status;
 839              	
