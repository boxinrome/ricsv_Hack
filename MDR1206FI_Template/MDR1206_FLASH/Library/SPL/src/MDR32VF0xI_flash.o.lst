 1984              	    FLASH_MassErase();
 1985              	    FLASH_EraseAllPages(FLASH_BANK_INFO);
 1986              	#elif defined(USE_MDR1206)
 1987              	    FLASH_MassErase_ID215();
 1988              	    FLASH_EraseAllPages_ID215(FLASH_BANK_INFO);
 1989              	#endif
 1990              	}
