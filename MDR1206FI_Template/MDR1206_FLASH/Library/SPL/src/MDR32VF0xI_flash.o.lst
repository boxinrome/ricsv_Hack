 242              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI) || defined(USE_MDR1206)
 243              	/**
 244              	 * @brief  Erase the main bank or the main and the information banks.
 245              	 * @note   This function can be used only for MDR32F02 and MDR1206FI (ID = 217).
 246              	 * @param  Bank: @ref FLASH_EraseMemoryBank_TypeDef - select a FLASH bank to erase.
 247              	 *         This parameter can be one of the following values:
 248              	 *             @arg FLASH_ERASE_BANK_MAIN: The FLASH main bank;
 249              	 *             @arg FLASH_ERASE_BANK_ALL:  The FLASH main and information banks.
 250              	 * @return None.
 251              	 */
 252              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI)
 253              	static void FLASH_MassErase(FLASH_EraseMemoryBank_TypeDef Bank)
 254              	#elif defined(USE_MDR1206)
 255              	/** @cond */
 256              	static void FLASH_MassErase_ID217(FLASH_EraseMemoryBank_TypeDef Bank)
 257              	/** @endcond */
 258              	#endif
 259              	{
 260              	    uint32_t Command;
 261              	    uint32_t DelayConst;
 262              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206)
 263              	    uint32_t Block;
 264              	#endif
 265              	    uint32_t MStatus;
 266              	
 267              	    /* Check the parameters. */
 268              	    assert_param(IS_FLASH_ERASE_BANK(Bank));
 269              	
 270              	    DelayConst = DELAY_CYCLE_COUNTER_GET_CONST_US(SystemCoreClock);
 271              	
 272              	    MStatus = CSR_ReadClearBits(CSR_MSTATUS, CSR_MSTATUS_MIE);
 273              	    Command = (MDR_FLASH->CMD & FLASH_CMD_DELAY_Msk) | FLASH_CMD_CON | FLASH_CMD_TMR;
 274              	    Command |= (Bank == FLASH_ERASE_BANK_ALL) ? FLASH_CMD_IFREN : 0;
 275              	    MDR_FLASH->CMD = Command;
 276              	
 277              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206)
 278              	    for (Block = 0; Block < 2; Block++) {
 279              	        MDR_FLASH->ADR = (Block << FLASH_ADR_MAIN_BLOCK_Pos) | (Block << FLASH_ADR_INFO_BLOCK_Pos);
 280              	#endif
 281              	        Command |= FLASH_CMD_XE | FLASH_CMD_MAS1 | FLASH_CMD_ERASE;
 282              	        MDR_FLASH->CMD = Command;
 283              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TNVS_US, DelayConst));
 284              	
 285              	        Command |= FLASH_CMD_NVSTR;
 286              	        MDR_FLASH->CMD = Command;
 287              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TME_US, DelayConst));
 288              	
 289              	        Command &= ~FLASH_CMD_ERASE;
 290              	        MDR_FLASH->CMD = Command;
 291              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TNVH1_US, DelayConst));
 292              	
 293              	        Command &= ~(FLASH_CMD_XE | FLASH_CMD_MAS1 | FLASH_CMD_NVSTR);
 294              	        MDR_FLASH->CMD = Command;
 295              	#if defined(USE_MDR1206FI) || defined(USE_MDR1206)
 296              	    }
 297              	#endif
 298              	    MDR_FLASH->CMD = (Command & FLASH_CMD_DELAY_Msk) | FLASH_CMD_TMR;
 299              	    CSR_Write(CSR_MSTATUS, MStatus);
 300              	}
 301              	
 302              	/**
 303              	 * @brief  Cycle for programming an 32-bit value.
 304              	 *         The initial programming procedure must first be completed.
 305              	 * @note   This function can be used only for MDR32F02 or MDR1206FI (ID = 217).
 306              	 * @param  Command: The command value, to which is added the set/clear of PROG2 bit.
 307              	 * @param  DelayProg: FLASH_TPROG_US delay time in loops.
 308              	 * @return None.
 309              	 */
 310              	#if defined(USE_MDR32F02) || defined(USE_MDR1206FI)
 311              	void FLASH_ProgramCycle(uint32_t Command, uint32_t DelayProg)
 312              	#elif defined(USE_MDR1206)
 313              	/** @cond */
 314              	void FLASH_ProgramCycle_ID217(uint32_t Command, uint32_t DelayProg)
 315              	/** @endcond */
 316              	#endif
 317              	{
 318              	    Command |= FLASH_CMD_YE;
 319              	    MDR_FLASH->CMD = Command;
 320              	    DELAY_CycleCounter_WaitTicksAsm(DelayProg);
 321              	
 322              	    Command &= ~FLASH_CMD_YE;
 323              	    MDR_FLASH->CMD = Command;
 324              	}
 325              	#endif
 326              	
 327              	#if defined(USE_MDR1206AFI) || defined(USE_MDR1206)
 328              	/**
 329              	 * @brief  Erase the main memory bank.
 330              	 * @note   This function can be used only for MDR1206AFI (ID = 215).
 331              	 * @param  None.
 332              	 * @return None.
 333              	 */
 334              	#if defined(USE_MDR1206AFI)
 335              	static void FLASH_MassErase(void)
 336              	#elif defined(USE_MDR1206)
 337              	/** @cond */
 338              	static void FLASH_MassErase_ID215(void)
 339              	/** @endcond */
 340              	#endif
 341              	{
 342              	    uint32_t Command;
 343              	    uint32_t DelayConst;
 344              	    uint32_t Sector;
 345              	    uint32_t MStatus;
 346              	
 347              	    DelayConst = DELAY_CYCLE_COUNTER_GET_CONST_US(SystemCoreClock);
 348              	
 349              	    MStatus        = CSR_ReadClearBits(CSR_MSTATUS, CSR_MSTATUS_MIE);
 350              	    Command        = FLASH_CMD_CON | FLASH_CMD_TMEN;
 351              	    MDR_FLASH->CMD = Command;
 352              	
 353              	    for (Sector = 0; Sector < 2; Sector++) {
 354              	        MDR_FLASH->ADR = Sector << FLASH_ADR_MAIN_SECTOR_Pos;
 355              	        Command |= FLASH_CMD_CE | FLASH_CMD_CHIP | FLASH_CMD_ERASE;
 356              	        MDR_FLASH->CMD = Command;
 357              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TNVS_CHIP_ERASE_US, DelayConst));
 358              	
 359              	        Command |= FLASH_CMD_WE;
 360              	        MDR_FLASH->CMD = Command;
 361              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TERASE_CHIP_ERASE_US, DelayConst))
 362              	
 363              	        Command &= ~FLASH_CMD_WE;
 364              	        MDR_FLASH->CMD = Command;
 365              	        DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TRCV_CHIP_ERASE_US, DelayConst));
 366              	
 367              	        Command &= ~(FLASH_CMD_CE | FLASH_CMD_CHIP | FLASH_CMD_ERASE);
 368              	        MDR_FLASH->CMD = Command;
 369              	    }
 370              	    MDR_FLASH->CMD = FLASH_CMD_TMEN;
 371              	
 372              	    DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TRW_CHIP_ERASE_US, DelayConst));
 373              	    CSR_Write(CSR_MSTATUS, MStatus);
 374              	}
 375              	
 376              	/**
 377              	 * @brief  Cycle for programming an 8-bit values within a 32-bit word.
 378              	 *         The initial programming procedure must first be completed.
 379              	 * @note   This function can be used only for MDR1206AFI (ID = 215).
 380              	 * @param  StartByte: Byte from which programming begins. Must be from 0 to 3.
 381              	 * @param  Size: @ref FLASH_ProgramSize_TypeDef - select a number of bytes for programming. Should 
 382              	 * @param  Command: The command value, to which is added the set/clear of PROG2 bit.
 383              	 * @param  DelayProg: FLASH_TPROG_PROGRAM_US delay time in loops.
 384              	 * @param  DelayAdsAdh: FLASH_TADS_PROGRAM_US/FLASH_TADH_PROGRAM_US delay time in loops.
 385              	 * @return None.
 386              	 */
 387              	#if defined(USE_MDR1206AFI)
 388              	void FLASH_ProgramCycle(uint32_t StartByte, FLASH_ProgramSize_TypeDef Size, uint32_t Command, uint3
 389              	#elif defined(USE_MDR1206)
 390              	/** @cond */
 391              	void FLASH_ProgramCycle_ID215(uint32_t StartByte, FLASH_ProgramSize_TypeDef Size, uint32_t Command,
 392              	/** @endcond */
 393              	#endif
 394              	{
 395              	    uint32_t Byte;
 396              	
 397              	    /* Check the parameters. */
 398              	    assert_param(IS_FLASH_PROGRAM_START_BYTE(StartByte));
 399              	    assert_param(IS_FLASH_PROGRAM_SIZE(Size));
 400              	    assert_param(IS_FLASH_PROGRAM_END_BYTE(StartByte + (uint32_t)Size));
 401              	
 402              	    for (Byte = StartByte; Byte < StartByte + (uint32_t)Size; Byte++) {
 403              	        MDR_FLASH->CTRL = 1 << Byte;
 404              	        DELAY_CycleCounter_WaitTicksAsm(DelayAdsAdh);
 405              	
 406              	        Command |= FLASH_CMD_PROG2;
 407              	        MDR_FLASH->CMD = Command;
 408              	        DELAY_CycleCounter_WaitTicksAsm(DelayProg);
 409              	
 410              	        Command &= ~FLASH_CMD_PROG2;
 411              	        MDR_FLASH->CMD = Command;
 412              	        DELAY_CycleCounter_WaitTicksAsm(DelayAdsAdh);
 413              	    }
 414              	}
 415              	
 416              	/**
 417              	 * @brief   Program the specified number of 8-bit FLASH memory values.
 418              	 * @warning The same address (8-bit data) can't be programmed again before next erase.
 419              	 * @note    This function can be used only for MDR1206AFI (ID = 215).
 420              	 * @note    The delay uses the cycle counter and core clock from SystemCoreClock. Do not disable th
 421              	 *          Before calling FLASH_ProgramBytes(), you must update SystemCoreClock by calling SystemC
 422              	 * @param   Address: A FLASH memory address.
 423              	 * @param   Data: 32-bit data whose bytes will be program.
 424              	 * @param   Size: @ref FLASH_ProgramSize_TypeDef - select a number of bytes for programming.
 425              	 * @param   Bank: @ref FLASH_MemoryBank_TypeDef - select a FLASH bank (the main bank or the informa
 426              	 *                This parameter can be one of the following values:
 427              	 *                    @arg FLASH_BANK_MAIN: The FLASH main bank;
 428              	 *                    @arg FLASH_BANK_INFO: The FLASH information bank.
 429              	 * @return  None.
 430              	 */
 431              	static void FLASH_ProgramBytes(uint32_t Address, uint32_t Data, FLASH_ProgramSize_TypeDef Size, FLA
 432              	{
 433              	    uint32_t Command;
 434              	    uint32_t DelayConst;
 435              	    uint32_t DelayProg;
 436              	    uint32_t DelayAdsAdh;
 437              	    uint32_t DelayPgs;
 438              	    uint32_t StartByte;
 439              	    uint32_t MStatus;
 440              	
 441              	    /* Check the parameters. */
 442              	    assert_param(IS_FLASH_PROGRAM_SIZE(Size));
 443              	    assert_param(IS_FLASH_MEMORY_BANK(Bank));
 444              	
 445              	#if defined(USE_FACTORY_DATA_PROTECTION)
 446              	    if (Bank == FLASH_BANK_INFO) {
 447              	        if (((Address & FLASH_ADDR_INFO_WORD_MASK_ID215) >= FLASH_FACTORY_DATA_START_ADDR_ID215) &&
 448              	            ((Address & FLASH_ADDR_INFO_WORD_MASK_ID215) <= FLASH_FACTORY_DATA_END_ADDR_ID215)) {
 449              	            return;
 450              	        }
 451              	    }
 452              	#endif
 453              	
 454              	    if (Size == FLASH_PROGRAM_SIZE_4BYTE) {
 455              	        Address &= ~FLASH_ADDR_FOUR_BYTE_ALIGN_MASK;
 456              	    } else if (Size == FLASH_PROGRAM_SIZE_2BYTE) {
 457              	        Address &= ~FLASH_ADDR_TWO_BYTE_ALIGN_MASK;
 458              	    }
 459              	
 460              	    StartByte   = Address & FLASH_ADDR_BYTE_MASK;
 461              	    DelayConst  = DELAY_CYCLE_COUNTER_GET_CONST_US(SystemCoreClock);
 462              	    DelayProg   = DELAY_GET_TICKS_US(FLASH_TPROG_PROGRAM_US, DelayConst);
 463              	    DelayAdsAdh = DELAY_GET_TICKS_US(FLASH_TADS_PROGRAM_US, DelayConst);
 464              	    DelayPgs    = DELAY_GET_TICKS_US(FLASH_TPGS_PROGRAM_US, DelayConst);
 465              	
 466              	    /* Correct DelayProg for SystemCoreClock <= 16 MHz. */
 467              	    DelayProg = (SystemCoreClock > 16000000) ? DelayProg : DelayProg - 7;
 468              	
 469              	    MStatus = CSR_ReadClearBits(CSR_MSTATUS, CSR_MSTATUS_MIE);
 470              	    Command = FLASH_CMD_CON | FLASH_CMD_TMEN;
 471              	    Command |= (Bank == FLASH_BANK_INFO) ? FLASH_CMD_NVR : 0;
 472              	    MDR_FLASH->CMD = Command;
 473              	
 474              	    MDR_FLASH->ADR = FLASH_ConvertAddress(Address, Bank);
 475              	    MDR_FLASH->DI  = Data;
 476              	
 477              	    Command |= FLASH_CMD_CE | FLASH_CMD_PROG;
 478              	    MDR_FLASH->CMD = Command;
 479              	    DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TNVS_PROGRAM_US, DelayConst));
 480              	
 481              	    Command |= FLASH_CMD_WE;
 482              	    MDR_FLASH->CMD = Command;
 483              	    DELAY_CycleCounter_WaitTicksAsm(DelayPgs);
 484              	
 485              	#if defined(USE_MDR1206AFI)
 486              	    FLASH_ProgramCycle(StartByte, Size, Command, DelayProg, DelayAdsAdh);
 487              	#elif defined(USE_MDR1206)
 488              	    FLASH_ProgramCycle_ID215(StartByte, Size, Command, DelayProg, DelayAdsAdh);
 489              	#endif
 490              	
 491              	    Command &= ~FLASH_CMD_WE;
 492              	    MDR_FLASH->CMD = Command;
 493              	    DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TRCV_PROGRAM_US, DelayConst));
 494              	
 495              	    Command &= ~(FLASH_CMD_CE | FLASH_CMD_PROG);
 496              	    MDR_FLASH->CMD = Command;
 497              	    MDR_FLASH->CMD = FLASH_CMD_TMEN;
 498              	
 499              	    DELAY_CycleCounter_WaitTicksAsm(DELAY_GET_TICKS_US(FLASH_TRW_PROGRAM_US, DelayConst));
 500              	    CSR_Write(CSR_MSTATUS, MStatus);
 501              	}
 502              	
 503              	/**
 504              	 * @brief  Convert the FLASH memory word address to a special address required for register access.
 505              	 * @note   This function can be used only for MDR1206AFI (ID = 215).
 506              	 * @param  Address: A FLASH memory word address.
 507              	 * @param  Bank: @ref FLASH_MemoryBank_TypeDef - select a FLASH bank (the main bank or the informat
 508              	 *         This parameter can be one of the following values:
 509              	 *             @arg FLASH_BANK_MAIN: The FLASH main bank;
 510              	 *             @arg FLASH_BANK_INFO: The FLASH information bank.
 511              	 * @return Address required for register access.
 512              	 */
 513              	static uint32_t FLASH_ConvertAddress(uint32_t Address, FLASH_MemoryBank_TypeDef Bank)
 514              	{
 515              	    if (FLASH_GET_SECTOR_NUMBER(Address) == 0) {
 516              	        Address = (Address >> 1) & ((Bank == FLASH_BANK_INFO) ? ~FLASH_ADR_INFO_SECTOR_Msk : ~FLASH
 517              	    } else {
 518              	        Address = (Address >> 1) | ((Bank == FLASH_BANK_INFO) ? FLASH_ADR_INFO_SECTOR_Msk : FLASH_A
 519              	    }
 520              	
 521              	    return Address;
 522              	}
 523              	#endif
